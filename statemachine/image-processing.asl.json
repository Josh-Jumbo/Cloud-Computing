{
  "Comment": "Resize an image and check the result",
  "QueryLanguage": "JSONPath",
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "YOUR_RESIZEIMAGE_FUNCTION_ARN",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "result.$": "$.Payload"
      },
      "ResultPath": "$.resize",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ProcessingFailed"
        }
      ],
      "Next": "CheckResizeResult"
    },
    "CheckResizeResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.resize.result.success",
          "BooleanEquals": true,
          "Next": "ProcessingSucceeded"
        }
      ],
      "Default": "ProcessingFailed"
    },
    "ProcessingSucceeded": {
      "Type": "Succeed"
    },
    "ProcessingFailed": {
      "Type": "Fail",
      "Error": "ImageProcessingFailed",
      "Cause": "The image could not be resized."
    }
  }
}