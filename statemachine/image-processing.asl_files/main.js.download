  /* Copied from Polaris Grid */
  border-collapse: separate;
  border-spacing: 0;
  caption-side: top;
  cursor: auto;
  direction: ltr;
  empty-cells: show;
  font-family: serif;
  font-size: medium;
  font-style: normal;
  font-variant: normal;
  font-weight: normal;
  font-stretch: normal;
  line-height: normal;
  hyphens: none;
  letter-spacing: normal;
  list-style: disc outside none;
  tab-size: 8;
  text-align: left;
  text-align-last: auto;
  text-indent: 0;
  text-shadow: none;
  text-transform: none;
  visibility: visible;
  white-space: normal;
  widows: 2;
  word-spacing: normal;
  box-sizing: border-box;
  font-size: 14px;
  line-height: 22px;
  color: #16191f;
  font-weight: 400;
  font-family: "Amazon Ember", "Helvetica Neue", Roboto, Arial, sans-serif;
  display: flex;
  flex-wrap: wrap;
  margin: calc(20px / -2);
  pointer-events: none;

  & > * {
    box-sizing: border-box;
    display: flex;
    width: 100%;
    flex: 0 0 100%;
    padding: 10px;
  }

  &.variant--text-grid > * {
    border-left: 1px solid #eaeded;
  }

  &.variant--text-grid > *:first-child {
    border-left: 0;
  }

  & > * > * {
    width: 100%;
    pointer-events: all;
  }

  /* Breakpoints based on Polaris' internal/breakpoints.js */
  @media all and (min-width: 465px) {
    & > * {
      flex: 0 0 50%;
      width: 50%;
      max-width: 50%;
    }
  }

  @media all and (min-width: 688px) {
    & > * {
      flex: 0 0 33%;
      width: 33%;
      max-width: 33%;
    }
  }

  @media all and (min-width: 912px) {
    & > * {
      flex: 0 0 20%;
      width: 20%;
      max-width: 20%;
