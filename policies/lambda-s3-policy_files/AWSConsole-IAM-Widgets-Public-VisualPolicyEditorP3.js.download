cté.","chargeAssociatedWithCheck":"Des frais sont associés à chaque vérification de nouvel accès.","learnMoreAccessAnalyzerPricing":"En savoir plus sur la tarification de l’Analyseur d’accès IAM","registerDeviceLimit":"Vous pouvez enregistrer jusqu’à 8 appareils MFA de n’importe quelle combinaison des types MFA actuellement pris en charge avec votre compte racine AWS et votre utilisateur IAM. Avec plusieurs appareils MFA, vous n’avez besoin que d’un seul appareil MFA pour vous connecter à la console AWS ou créer une session via l’AWS CLI avec cette personne.","opensInNewTabAriaLabel":"S’ouvre dans un nouvel onglet","unknownError":"Erreur inconnue","passkeyAddedRootSuccessMsg":"Dans le cadre des meilleures pratiques en matière de sécurité, nous vous recommandons de vous assurer que votre adresse e-mail et votre numéro de contact sont à jour, et nous vous encourageons à inscrire plusieurs appareils au cas où votre méthode principale serait perdue, désactivée ou indisponible.","passkeyAddedSuccessMsg":"À titre de meilleure pratique en matière de sécurité, nous vous recommandons d’enregistrer plusieurs appareils au cas où votre méthode principale serait perdue, désactivée ou indisponible. Choisissez l’un de vos appareils MFA à utiliser pour vous connecter à votre compte AWS.","passkeyAddedHeader":"Appareil MFA à clé d’accès attribué","passkeySetupDesc":"Les clés d’accès vous permettent de vous connecter en toute sécurité à votre compte AWS à l’aide de votre empreinte digitale, de votre visage, du verrouillage de l’écran ou de la clé de sécurité FIDO2.","passkeySetupStep1Label":"Étape 1 sur 2","passkeySetupStep1":"Créez une clé d’accès sur cet appareil ou, si vous utilisez un autre appareil, connectez-le maintenant.","passkeySetupStep2Label":"Étape 2 sur 2","passkeySetupStep2":"Suivez les instructions de votre navigateur.","passkeySetupLoading":"Chargement en cours","passkeySetupTitle":"Clé d’accès ou clé de sécurité","windowsPasskeyWarning":"Il se peut que vous ne puissiez pas enregistrer directement une clé d’accès sur certains appareils Windows, tels que ceux qui exécutent Windows 10. Vous pouvez plutôt utiliser un appareil secondaire tel que votre téléphone portable. Assurez-vous que votre ordinateur et votre appareil secondaire sont connectés à Internet et que le Bluetooth est activé.","closeActionInfoModalAriaLabel":"Fermer la fenêtre modale","allActions":"Toutes les actions","fixErrorsBeforeFullScreenMode":"Corrigez toutes les erreurs de syntaxe de cette politique avant de passer en mode plein écran.","fixErrorsBeforeLeavingFullScreenMode":"Corrigez toutes les erreurs de syntaxe de cette politique avant de quitter le mode plein écran.","fixErrorsBeforeSwitchingModes":"Avant de passer à l’éditeur visuel, corrigez les erreurs de syntaxe dans votre politique.","policyOptimizedForSize":"Politique optimisée pour la taille tant qu’aucune autre modification n’est apportée.","policyNotOptimizedForSize":"Politique non optimisée pour la taille. Corrigez les erreurs et essayez de nouveau.","policyOptimizedForReadability":"Politique optimisée pour la lisibilité tant qu’aucune autre modification n’est apportée.","policyNotOptimizedForReadability":"Politique non optimisée pour la lisibilité. Corrigez les erreurs et essayez de nouveau.","infoAboutOptimizing":"Informations sur l’optimisation","actions":"Actions","restrictAccessToArnForResource":"Restreignez l’accès à tout ARN pour la ressource {resourceName} de ce compte.","allResources":"Toutes les ressources","closePopover":"Fermer la fenêtre contextuelle","commonlyUsedServices":"Services couramment utilisés","otherServices":"Autres services","selectServiceAriaLabel":"(Service {serviceIndex}) Sélectionner un service","service":"Service","selectServiceToAdd":"Sélectionner un service à ajouter à cette politique","filterServiceWithTextInput":"Rechercher des services avec saisie de texte","clearFilterAndShowServices":"Effacer le filtre et afficher tous les services","chooseServie":"Choisir un service","selectedService":"Service {service} sélectionné","noOptionSelected":"Aucune option sélectionnée","filterServicesPlaceholder":"Rechercher des services","noMatchesFound":"Aucune correspondance trouvée","loadingServices":"Chargement des services","denyingService":"Refus de {numberOfActionsText} dans le service {serviceName}","allowingService":"Autorisation de {numberOfActionsText} dans le service {serviceName}","allServices":"(Tous les services)","deny":"Refuser","allow":"Autoriser","cloneConfiguration":"Cloner cette configuration","removeConfiguration":"Supprimer cette configuration","setPermissionsForUser":"Définir les autorisations pour {displayName}","selectAService":"(Service {serviceIndex}) Sélectionner un service","serviceData":"(Service {serviceIndex}) Données de service pour {service}","filterActionsForService":"Filtrer les actions pour le service","clearFilterForService":"Effacer le filtre et afficher toutes les actions pour le service","effectAllow":"Autoriser","effectDeny":"Refuser","specifyArns":"Spécifier le ou les ARN","resourceArns":"ARN de ressource","placeholder":"Spécifier le ou les ARN","specifyArnsToRestrictResource":"Spécifier les ARN auxquels vous voulez restreindre l’accès à {resourceName}","moreActionsForResource":"Actions supplémentaires pour {resourceName}","dismissPopover":"Ignorer la fenêtre contextuelle","closePopoverAriaLabel":"Fermer la fenêtre contextuelle","popoverInfo":"Infos"}}')},80329:(e,t,a)=>{var o=a(89019);function r(){}function i(e){return e.isQueryName||"ec2"!==e.api.protocol?e.name:e.name[0].toUpperCase()+e.name.substr(1)}function n(e,t,a,r){o.each(a.members,function(a,o){var n=t[a];if(null!=n){var l=i(o);s(l=e?e+"."+l:l,n,o,r)}})}function s(e,t,a,r){null!=t&&("structure"===a.type?n(e,t,a,r):"list"===a.type?function(e,t,a,r){var n=a.member||{};0!==t.length?o.arrayEach(t,function(t,o){var l="."+(o+1);if("ec2"===a.api.protocol)l+="";else if(a.flattened){if(n.name){var c=e.split(".");c.pop(),c.push(i(n)),e=c.join(".")