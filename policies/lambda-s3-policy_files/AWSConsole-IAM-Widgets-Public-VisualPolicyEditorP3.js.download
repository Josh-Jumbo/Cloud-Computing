.svg', stroke=$color-text-body-default, fill=$color-text-body-default) !important;\n                }\n            }\n        }\n    }\n\n    .editor-panel-button {\n        border: $standard-border;\n        margin-left: 10px;\n        margin-top: 10px;\n        margin-bottom: 10px;\n        padding: 0px;\n        min-width: 175px;\n        width: 90%;\n        max-width: -moz-fit-content;\n        max-width: fit-content;\n        color: $color-text-link-default !important;\n        overflow: hidden !important;\n        .awsui-button.awsui-button-variant-link.awsui-hover-child-icons {\n            &:focus {\n                background-color: var(--awsui-color-background-button-primary-hover);\n                color: var(--awsui-color-text-inverted);\n            }\n            left: -3px;\n\n            width: calc(100% + 13px);\n        }\n    }\n    .ace-editor-wrapper {\n        flex-grow: 1;\n        height: $ace-editor-height;\n        overflow: hidden;\n        resize: none;\n        margin: 0;\n        padding: 0;\n        border-radius: 0;\n        background-color: $color-background-container-header;\n        border-left: none;\n\n        .ace_editor {\n            height: 100%;\n            width: 100%;\n\n            &.disabled {\n                @include opacity(0.5);\n            }\n\n            &__highlight {\n                background-color: $color-text-input-placeholder;\n                opacity: 0.3;\n                position: absolute;\n            }\n        }\n    }\n\n    .editor-toolbar {\n        background: $standard-background-color;\n        box-sizing: content-box;\n        left: 0;\n        border-radius: 0 0 5px 5px;\n        top: 0;\n\n        &__group {\n            padding-left: 45px;\n        }\n        &__add-statement {\n            font-weight: 600;\n            background-color: $color-background-container-header;\n            border-top: $standard-border;\n            padding: $space-static-xs;\n        }\n    }\n    .finding-marker {\n        position: absolute;\n        background-color: $color-background-layout-main;\n    }\n}\n","// This file is used for listing all the colors for IE\n// In Internet explorer, var() is not valid.\n// So, I am declaring all the list of colors we use here and use them in individual widgets.\n// These colors must only be used for IE.\n// The way we should be assigning colors is:\n// color: $awsui-color-grey-150\n// color: var(--$awsui-color-grey-150)\n// This way browsers that support var will use the proper colors, but for IE it will use the declarations here.\n$awsui-color-grey-100: #fafafa;\n$awsui-color-grey-150: #f2f3f3;\n$clone-awsui-color-grey-150: #f2f3f3;\n$awsui-color-grey-200: #eaeded;\n$awsui-color-grey-300: #d5dbdb;\n$awsui-color-grey-400: #aab7b8;\n$awsui-color-grey-450: #95a5a6;\n$awsui-color-grey-550: #687078;\n$awsui-color-grey-600: #545b64;\n$awsui-color-grey-900: #16191f;\n$awsui-color-grey-150: #f2f3f3;\n\n$awsui-color-red-600: #d13212;\n$awsui-color-blue-100: #f1faff;\n$awsui-color-blue-500: #00a1c9;\n$awsui-color-blue-600: #0073bb;\n$awsui-color-white: #ffffff;\n$awsui-color-green-600: #1d8102;\n$security-warning-color: #7d2105;\n",".awsui-util-container-footer {\n    background-color: $color-background-container-header;\n    height: 40px;\n    width: 100%;\n    border: $standard-border;\n    margin-top: -2px;\n    display: flex;\n    justify-content: space-between;\n\n    .left-container {\n        width: 45%;\n        display: flex;\n        min-width: 300px;\n        max-width: 550px;\n        justify-content: flex-start;\n        color: $color-text-body-secondary;\n\n        span {\n            padding-left: 12px;\n            margin-top: auto;\n            margin-bottom: auto;\n            &.inactive {\n                color: $color-text-status-inactive;\n            }\n\n            &.warning {\n                color: $color-text-status-warning;\n            }\n\n            &.error {\n                color: $color-text-status-error;\n            }\n        }\n    }\n\n    .right-container {\n        display: flex;\n        .awsui-popover {\n            padding-left: 12px;\n            margin-top: 8px;\n            margin-bottom: auto;\n            padding-right: 12px;\n        }\n        .awsui-button {\n            height: 100%;\n            background-color: $color-background-container-header;\n            border: none;\n            border-left: $standard-border;\n            padding: 1px 12px;\n        }\n    }\n}\n"," div.awsui-flex-row {\n        display: flex;\n\n        .right-control-panel-container {\n            min-width: 250px;\n            max-width: 800px;\n            border-top: $standard-border;\n            border-right: $standard-border;\n        }\n\n        .left-control-panel-container {\n            flex: 1;\n            flex-grow: 1;\n            min-width: 190px;\n        }\n        .draggable {\n            border-top: $standard-border;\n            width: 6px;\n            background-color: $color-background-control-disabled;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin-right: -1px;\n            cursor: col-resize;\n            span.dragIndicator {\n                width: 3px;\n                border-left: $standard-border;\n                border-right: $standard-border;\n                height: 20px;\n                margin-right: 1px;\n            }\n        }\n    }",".add-resource-modal,\n.remove-resource-modal,\n.add-condition-modal,\n.add-principal-modal {\n    .awsui-modal-body {\n         overflow: initial;\n       padding-bottom: 2.5rem; \n    }\n    .awsui-control-group-label {\n        width: 25%;\n    }\n    .awsui-control-group-controls {\n        width: 75%;\n    }\n    .awsui-control-group-control {\n        width: 100%;\n    }\n    .condition-modal-operator {\n        &__group {\n            display: flex;\n\n            awsui-select {\n                width: 75%;\n            }\n            awsui-checkbox {\n                margin-left: 15px;\n                padding-top: 10px;\n            }\n        }\n    }\n    .condition-modal-values {\n        textarea {\n            max-width: 100%;\n        }\n    }\n    .modal-content-description {\n        pre {\n            max-height: 300px;\n            overflow: scroll;\n        }\n    }\n\n    .selector-alert {\n        border: none;\n\n        .awsui-alert.awsui-alert-type-warning {\n            border: none;\n            padding: 0;\n            margin: 0;\n        }\n\n        .awsui-alert-icon {\n            position: unset;\n        }\n\n        .awsui-alert-body {\n            .awsui-alert-message {\n                color: $color-text-status-error;\n            }\n        }\n    }\n\n    .awsui-modal-dialog.awsui-modal-size-medium {\n        box-shadow: none;\n    }\n    .awsui-select-dropdown-options-container {\n        max-height: 155px !important;\n    }\n\n    .awsui-modal-footer.awsui-util-container-footer,\n    .awsui-modal-header.awsui-util-container-header {\n        background-color: $color-background-container-header !important;\n    }\n    .awsui-modal-footer.awsui-util-container-footer {\n        justify-content: flex-end;\n        height: 50px;\n        border-bottom: none;\n        border-left: none;\n        border-right: none;\n    }\n}\n","@mixin center-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    background: $color-background-container-content;\n}\n\n.services-container {\n    &__list {\n        p {\n            padding-left: 4px;\n        }\n    }\n    &__list-item {\n        padding-left: 0px;\n        padding-top: 0px;\n        button {\n            height: 24px;\n            border: none;\n            width: 100%;\n            text-align: left;\n            background-color: transparent;\n            cursor: pointer;\n            padding-bottom: 6px;\n            color: $color-text-button-normal-default;\