/11/aws-sts-ecdsa-based-signatures-oidc-tokens\\", \\"postDateTime\\": \\"11/22/2024\\", \\"absoluteDateTime\\": \\"2024-11-22T15:15:00-05:00\\"}, \\"característica15\\": {\\"headline\\": \\"Amazon EKS simplifies providing IAM permissions to EKS add-ons\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/amazon-eks-iam-permissions-eks-add-ons\\", \\"postDateTime\\": \\"11/18/2024\\", \\"absoluteDateTime\\": \\"2024-11-18T17:00:00-05:00\\"}, \\"característica16\\": {\\"headline\\": \\"Centrally manage root access in AWS Identity and Access Management (IAM)\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/manage-root-access-aws-identity-access-management/\\", \\"postDateTime\\": \\"11/15/2024\\", \\"absoluteDateTime\\": \\"2024-11-15T10:00:00-08:00\\"}, \\"característica17\\": {\\"headline\\": \\"Customize scope of IAM Access Analyzer unused access analysis  \\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/customize-scope-iam-access-analyzer-unused-access-analysis/\\", \\"postDateTime\\": \\"11/14/2024\\", \\"absoluteDateTime\\": \\"2024-11-14T10:00:00-08:00\\"}, \\"característica18\\": {\\"headline\\": \\"Introducing resource control policies (RCPs) to centrally restrict access to AWS resources\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/resource-control-policies-restrict-access-aws-resources/\\", \\"postDateTime\\": \\"11/13/2024\\", \\"absoluteDateTime\\": \\"2024-11-13T10:00:00-08:00\\"}, \\"característica19\\": {\\"headline\\": \\"AWS IAM now supports PrivateLink in the AWS GovCloud (US) Regions\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/aws-iam-privatelink-govcloud-us-regions\\", \\"postDateTime\\": \\"11/08/2024\\", \\"absoluteDateTime\\": \\"2024-11-08T13:00:00-05:00\\"}, \\"característica20\\": {\\"headline\\": \\"Streamline automation of policy management workflows with service reference information\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/10/streamline-automation-policy-management-workflows-service-reference-information\\", \\"postDateTime\\": \\"10/10/2024\\", \\"absoluteDateTime\\": \\"2024-10-10T13:00:00-04:00\\"}, \\"característica21\\": {\\"headline\\": \\"Amazon S3 Access Grants introduce the ListCallerAccessGrants API\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/09/amazon-s3-access-grants-listcalleraccessgrants-api\\", \\"postDateTime\\": \\"09/05/2024\\", \\"absoluteDateTime\\": \\"2024-09-05T17:50:00-04:00\\"}, \\"característica22\\": {\\"headline\\": \\"AWS Identity and Access Management now supports AWS PrivateLink in all commercial Regions\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/08/aws-identity-access-management-aws-privatelink-regions/\\", \\"postDateTime\\": \\"08/22/2024\\", \\"absoluteDateTime\\": \\"2024-08-22T10:00:00-07:00\\"}, \\"característica23\\": {\\"headline\\": \\"AWS Identity and Access Management simplifies management of OpenID Connect identity providers\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/07/aws-identity-access-management-open-id-connect-identity-providers\\", \\"postDateTime\\": \\"07/12/2024\\", \\"absoluteDateTime\\": \\"2024-07-12T16:30:00-04:00\\"}, \\"característica24\\": {\\"headline\\": \\"AWS IAM Access Analyzer now offers policy checks for public and critical resource access\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/06/aws-iam-access-analyzer-policy-checks\\", \\"postDateTime\\": \\"06/11/2024\\", \\"absoluteDateTime\\": \\"2024-06-11T08:00:00-04:00\\"}}","today":" Hoy","yesterday":" Ayer","daysAgo":" Hace {day} días","weekAgo":" Hace una semana","weeksAgo":" Hace {week} semanas","monthAgo":" Hace un mes","monthsAgo":" Hace {month} meses","yearAgo":" Hace un año","header":"Novedades","description":"Actualizaciones de características en IAM","viewAll":"Ver todo","viewAllAria":"Ver todas las novedades","more":"más","less":"menos","moreAria":"Mostrar más resultados","lessAria":"Mostrar menos resultados"},"mfaListWidget":{"mfaListLoadingText":"Cargando","mfaListTableHeader":"Autenticación multifactor (MFA)","mfaListTableHeaderDescription":"Como práctica recomendada, utilice MFA para aumentar la seguridad de los entornos de AWS. El inicio de sesión en cuentas protegidas por MFA requiere un nombre de usuario, una contraseña y un código de autenticación de un dispositivo MFA.","remove":"Eliminar","resync":"Volver a sincronizar","assignMfa":"Asignar MFA","noDevice":"No hay dispositivos MFA","noDeviceDescription":"Agregue un dispositivo MFA para aumentar la seguridad del entorno de AWS","deleteMFAModal":"¿Desea eliminar el dispositivo MFA?","deleteMFAContent":"No será necesario que proporcione códigos de MFA cuando inicien sesión.","cancel":"Cancelar","resyncMFATitle":"Volver a sincronizar el dispositivo MFA","resyncMFAContent":"Complete dos códigos consecutivos del dispositivo MFA para volver a sincronizarlo.","resyncInput1":"Código de MFA 1","resyncInput2":"Código de MFA 2"},"selectMFADevice":{"virtualDesc":"Autenticarse mediante un código generado por una aplicación instalada en el dispositivo móvil o la computadora.","u2fDesc":"Autenticarse mediante un código generado al tocar una YubiKey u otro dispositivo compatible con U2F.","hardwareDesc":"Autentíquese con un código que se muestra en un token de contraseña temporal de un solo uso (TOTP) de hardware.","authenticatorApp":"Aplicación del autenticador","u2fSecurityKey":"Llave de seguridad U2F","hardwareDevice":"Token de contraseña temporal de un solo uso (TOTP) de hardware","selectDevice":"Seleccionar el dispositivo MFA","selectDeviceSmall":"Seleccionar un dispositivo MFA para utilizarlo, además del nombre de usuario y la contraseña, siempre que necesite autenticarse.","cancel":"Cancelar","next":"Siguiente"},"setupMFADevice":{"pageTitle":"Activar la autenticación multifactor (MFA)","setupTitle":"Configurar la aplicación de autenticador","virtualDesc":"Un dispositivo MFA virtual es una aplicación que se ejecuta en el dispositivo y que puede configurar al escanear un código QR.","install":"Instale una aplicación compatible, como Google Authenticator, Duo Mobile o Authy, en su dispositivo móvil o computadora.","list":"Consultar una lista de aplicaciones compatibles","show":"Mostrar código QR","step2Text":"Abra la aplicación de autenticación, elija <b>Mostrar código QR</b> en esta página y, a continuación, utilice la aplicación para escanear el código. También puede escribir una clave secreta. <show>Mostrar clave secreta</show>","step3Text":"Escriba dos códigos MFA consecutivos a continuación","code1":"Ingrese un código de su aplicación virtual a continuación","code2":"Espere 30 segundos e introduzca una segunda entrada de código.","cancel":"Cancelar","previous":"Anterior","addMFA":"Agregar MFA","hardwareTitle":"Configurar dispositivo MFA de hardware","hardwareDescription":"Para obtener más información sobre el uso de un dispositivo MFA de hardware, consulte la <a>Guía del usuario de IAM</a>","hardwareLabel1":"Ingrese el número de serie situado en la parte posterior del dispositivo.","hardwareLabel2":"Pulse el botón situado en la parte delantera del dispositivo e ingrese el número de 6 dígitos que aparece.","hardwareLabel3":"Espere 30 segundos y, a continuación, vuelva a pulsar el botón. Ingrese el segundo número.","serialNumber":"Número de serie","MFACode1":"Código de MFA 1","MFACode2":"Código de MFA 2","u2fTitle":"Configurar la llave de seguridad","u2fDesc":"Configuraciones admitidas para utilizar claves de seguridad","u2fStep1":"Conecte la llave de seguridad al dispositivo.","u2fStep2":"Pulse la llave de seguridad.","passkeySetupTitle":"Clave de paso o clave de seguridad","passkeySetupDesc":"Las claves de paso le permiten iniciar sesión de forma segura en su cuenta de AWS con la huella digital, el rostro, el PIN del dispositivo o la clave de seguridad FIDO2.","passkeySetupStep1Label":"Paso 1 de 2","passkeySetupStep1":"Cree una clave de paso en este dispositivo o, si usa otro dispositivo, conéctelo ahora.","passkeySetupStep2Label":"Paso 2 de 2","passkeySetupStep2":"Siga las instrucciones del navegador.","passkeySetupLoading":"Cargando","waiting":"Esperando la clave de seguridad…","tap":"Pulsar la tecla","troubleShoot":"Solucionar problemas de la autenticación multifactor (MFA)","u2fComplete":"Se ha completado la configuración de esta clave de seguridad U2F","u2fCompleteText":"Ahora debe pulsar esta clave de seguridad U2F para iniciar sesión.","done":"Listo","wizardStep1Title":"Seleccionar el dispositivo MFA","wizardStep2Title":"Configurar el dispositivo","optional":"Opcional","next":"Siguiente","retry":"Volver a intentar","selectVirtualDesc":"Autenticarse mediante un código generado por una aplicación instalada en el dispositivo móvil o la computadora.","selectU2fDesc":"Autentíquese mediante un código generado al tocar una YubiKey u otra llave de seguridad FIDO compatible.","selectPasskeyDesc":"Autentíquese mediante la huella digital, el rostro o el bloqueo de pantalla. Cree una clave de paso en este dispositivo o use otro dispositivo, como una clave de seguridad FIDO2.","hardwareDesc":"Autentíquese con un código que se muestra en un token de contraseña temporal de un solo uso (TOTP) de hardware.","selectHardwareOtherDeviceDesc":"Autentíquese mediante un código generado por el token de TOTP de hardware u otros dispositivos de hardware.","otherDesc":"Autenticarse mediante un código que aparezca en un token de Gemalto.","authenticatorApp":"Aplicación del autenticador","u2fSecurityKey":"Llave de seguridad U2F","hardwareDevice":"Token de contraseña temporal de un solo uso (TOTP) de hardware","selectDevice":"Seleccionar el dispositivo MFA","selectDeviceSmall":"Seleccionar un dispositivo MFA para utilizarlo, además del nombre de usuario y la contraseña, siempre que necesite autenticarse.","deviceSelectionLabel":"Opciones de dispositivo","deviceSelectionDescription":"Además del nombre de usuario y la contraseña, utilizará este dispositivo para autenticarse en la cuenta. ","displayNameLabel":"Nombre de visualización de la clave de paso","displayNameDescription":"Este nombre aparecerá al iniciar sesión con la clave de paso. El nombre sugerido de forma predeterminada se puede personalizar si es necesario.","displayNameDefaultSelection":"Utilizar el nombre predeterminado de visualización de la clave de paso","displayNameConstraintText":"Máximo 64 caracteres. Caracteres válidos: A-Z, a-z, 0-9, y + = , . @ _ - (guión)","displayNameLengthErrorText":"El nombre de visualización de la clave de paso no puede tener más de 64 caracteres","displayNameRequiredErrorText":"Se requiere el nombre de visualización de la clave de paso","displayNameInvalidCharactersErrorText":"Los caracteres no son válidos. Utilice caracteres válidos: A-Z, a-z, 0-9, así como + = , . @ _ - (guión)","stepNumber":"Paso {stepNumber}","stepLabel":"Paso {stepNumber} de {stepCount}","inputInValid":"La entrada debe ser un número de 6 dígitos","mfaAdded":"Dispositivo MFA asignado","mfaMessage":"Ahora debe autenticarse con este dispositivo MFA cuando inicie sesión en la consola de AWS.","securityKey":"Llave de seguridad","passkeyOrSecurityKey":"Clave de paso o clave de seguridad","webAuthNError":"No se puede registrar la llave de seguridad.","retryRequest":"Vuelva a intentar la solicitud.","deviceIneligibleDesc":"Este dispositivo no es compatible o ya se ha registrado.","u2fTimeoutDesc":"Reintentar la solicitud","configurationUnsupportedDesc":"El navegador que está utilizando no es compatible con las llaves de seguridad U2F.","defaultDesc":"Póngase en contacto con asistencia o inténtelo de nuevo más tarde.","deviceIneligibleTitle":"Hay un problema con el dispositivo","u2fTimeoutTitle":"Se ha agotado el tiempo de espera de la solicitud","configurationUnsupportedTitle":"Navegador no compatible","defaultTitle":"El servicio está experimentando problemas","beginRegistrationError":"Error al registrar la llave de seguridad","finaRegistrationError":"Error al registrar la llave de seguridad","specifyMFAName":"Especificar nombre del dispositivo MFA","