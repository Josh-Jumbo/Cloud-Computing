ACA,kBAAA,CACA,6DNgSuB,CM5R3B,2CACI,gBAAA,CAKZ,qEAEI,yEP3Bc,CO4Bd,WAAA,CACA,eAAA,CACA,iBAAA,CACA,iBAAA,CACA,0ENwJiC,CMvJjC,2EAAA,CACA,uGACI,UAAA,CACA,eAAA,CACA,gBAAA,CACA,yDNqOuB,CM7NvB,8BAAA,CACA,WAAA,CACA,oBAAA,CATA,6GACI,gBAAA,CACA,gBAAA,CACA,eAAA,CACA,iBAAA,CAOJ,iHACI,eAAA,CAEJ,mHACI,2DN0PqB,CMvP7B,2EASI,gBAAA,CACA,UAAA,CATA,qFACI,gBAAA,CAEJ,yGACI,WAAA,CACA,oBAAA,CACA,kBAAA,CAIJ,iHACI,wEAAA,CACA,wBAAA,CACA,iBAAA,CACA,eAAA,CACA,+CNgPS,CM7OjB,2EACE,QAAA,CACA,aAAA,CAEF,qHACI,iBPlES,COoEb,uFACI,wEPpFU,CORd,YAAA,CACA,sBAAA,CACA,kBAAA,CACA,oEN6LiC,CMhGjC,qFACI,cAAA,CACA,gBAAA,CACA,qKACI,cAAA,CAEJ,+MACI,cAAA,CACA,iBAAA,CAEJ,iGACI,eAAA,CACA,WPrGU,COsGV,iBAAA,CACA,4BAAA,CACA,yEPvGM,COwGN,0EPxGM,CO2Gd,iFACI,eAAA,CACA,iBP9FS,CO+FT,yHACI,eAAA,CACA,+CNyMS,CMxMT,oBAAA,CACA,eAAA,CACA,kBAAA,CAEA,cAAA,CAEA,+IACI,gBAAA,CACA,wEAAA,CAGR,2JAEQ,qBAAA,CAKZ,2FACI,kBAAA,CACA,sBAAA,CAEA,uGACI,4ENuD2B,CMpD/B,uHACI,kBAAA,CAIR,uGACI,aAAA,CACA,gBAAA,CAGJ,iHACI,0BAAA,CACA,2EAAA,CACA,sBAAA,CACA,gBAAA,CAGJ,2EACI,gBP9IS,CO+IT,2EAAA,CAGJ,iGACI,gBPnJS,COoJT,mBPpJS,CAgBb,0CACE,qBAAA,CAGF,iEACI,aAAA,CACA,cAAA,CACA,wGACI,aAAA,CACA,cAAA,CAIR,qBACI,QAAA,CACA,WAAA,CACA,eAAA,CAGJ,uCAEI,oBAAA,CAGJ,qBACI,YAAA,CACA,iBAAA,CAGJ,qBACI,aAAA,CACA,kBAAA,CACA,eAAA,CAEA,mDACI,iBAAA,CAIR,wBACI,cAAA,CAGA,+CACI,kBAAA,CAGR,4BAaI,kBAAA,CAZA,iCACI,kBAAA,CACA,wBAAA,CACA,eAAA,CACA,6CC4OO,CDzOP,+FACI,cAAA,CACA,eAAA,CAKZ,gCACI,kBAAA,CAGJ,wCACI,SAAA,CAGJ,uCACI,eAAA,CACA,cAAA,CACA,eAAA,CAKA,uHAEI,UAAA,CAIR,2CACI,iEAAA",sourcesContent:["@mixin control-panel-wrapper {\n    border: $standard-border;\n    border-radius: $standard-border-radius;\n    height: $policy-editor-app-height;\n    display: flex;\n    flex-direction: column;\n}\n@mixin control-panel-section {\n    background: $standard-background-color;\n}\n\n.control-panel {\n    border-bottom: $standard-border;\n    background-color: $standard-background-color;\n\n    h4 {\n      font-size: 14px;\n      line-height: 22px;\n    }\n\n    & > li {\n      height: 100%;\n    }\n\n    &__content {\n        @include control-panel-wrapper;\n        border: none;\n        border-radius: 0px;\n        padding: 0;\n        margin: 0;\n\n        ul,\n        li {\n          border-left: none;\n          border-right: none;\n          width: 100%;\n          padding: 0;\n          margin: 0;\n        }\n        li {\n          list-style-type: none;\n        }\n\n        & .control-panel__nav,\n        & .services-container__list {\n          padding-right: 12px;\n          padding-bottom: 5px;\n        }\n        & .control-panel__nav {\n          padding-left: 11px;\n        }\n        & .services-container__list {\n          padding-left: 13px;\n        }\n\n    }\n    .toggle-button-container {\n        display: flex;\n        padding-left: 10px;\n        padding-right: 10px;\n        margin-top: 5px;\n        margin-bottom: 10px;\n    }\n    .toggle-button-title {\n        margin-bottom: auto;\n        margin-top: auto;\n        margin-right: 10px;\n    }\n    .left-toggle-button {\n        button {\n            border: $standard-border;\n            border-radius: 0px;\n            border-top-left-radius: 6px;\n            border-bottom-left-radius: 6px;\n        }\n    }\n    .right-toggle-button {\n        button {\n            border: $standard-border;\n            border-radius: 0px;\n            border-top-right-radius: 6px;\n            border-bottom-right-radius: 6px;\n        }\n        margin-left: 0px;\n    }\n    &__title {\n        font-weight: bold;\n        white-space: nowrap;\n        // TODO: Need to re-address color for title header.\n        background: $standard-background-color;\n        color: $color-text-body-default;\n        border-radius: 0;\n        padding: 5px 0px 5px 0px;\n        border-bottom: 1px solid $standard-divider-color;\n        border-left: $standard-border;\n        display: flex;\n        justify-content: space-between;\n        min-height: 56px;\n\n        .flex-left {\n            flex: 1;\n\n            h3.title {\n                padding-left: 10px;\n                font-size: 18px;\n                line-height: 14px;\n                padding: 5px 0px 2px 10px;\n                margin: 0;\n                font-weight: normal;\n            }\n\n            h4.current-statement {\n                padding-left: 10px;\n                line-height: 21px;\n                padding-top: 0px;\n                border-bottom: none;\n                overflow-x: auto;\n                overflow-y: hidden;\n                &.no-title {\n                    line-height: 40px;\n                    border: none;\n                }\n                margin: 0;\n            }\n        }\n\n        .flex-right {\n            flex: 1;\n            justify-content: flex-end;\n            display: flex;\n            border: none;\n        }\n    }\n\n    &__nav {\n        @include control-panel-section;\n        padding-left: 10px;\n        background: $color-background-control-default;\n        padding-bottom: 5px;\n        border-bottom: 1px solid $standard-divider-color;\n        border-left: $standard-border;\n        padding-right: 10px;\n        color: $color-text-body-default;\n        .awsui-input-type-search {\n            width: -moz-available;\n        }\n        span {\n            margin-bottom: 4px;\n        }\n\n        &__button {\n            button {\n                padding-left: 0;\n                padding-right: 0;\n            }\n        }\n\n        &__text {\n            &::before {\n                margin-right: 0;\n            }\n        }\n        button.awsui-button.awsui-button-variant-link {\n            color: $color-text-link-default;\n            font-weight: 400;\n\n            span.awsui-button-region {\n                color: $color-text-link-default;\n            }\n        }\n        .awsui-util-mr-xs {\n            padding: 0 0 4px 0 !important;\n        }\n        .awsui-util-align-center {\n            align-items: center;\n        }\n        .awsui-util-primary-font {\n            color: $color-text-body-secondary !important;\n        }\n    }\n\n    .control-panel-button-section {\n        display: flex;\n        justify-content: space-between;\n        flex-wrap: wrap;\n        gap: 5px;\n\n        p, h4 {\n            flex: 3;\n            font-weight: bold;\n            padding-left: 12px;\n            line-height: 22px;\n            span {\n                font-weight: normal;\n            }\n        }\n        div {\n            flex: 1;\n            max-width: 120px;\n            padding-right: 12px;\n            margin-top: auto;\n            margin-bottom: auto;\n        }\n    }\n    .control-panel-button-container {\n        background-color: $color-background-control-default;\n        display: flex;\n        justify-content: flex-start;\n        flex-wrap: wrap;\n        border-left: $standard-border;\n        padding: 0;\n        color: $color-text-body-default;\n\n        ul, li {\n          padding: 0;\n          width: 100%;\n        }\n    }\n\n    .resource-container {\n        flex: 1;\n        padding: 0px 5px 0px 5px;\n        flex-grow: 1;\n    }\n    .condition-container {\n        flex: 1;\n        padding: 0px 5px 0px 5px;\n        flex-grow: 1;\n        flex-basis: max-content;\n    }\n\n    .entity-state {\n        width: 100%;\n        border-bottom: 1px solid $standard-divider-color;\n        padding-top: 9px;\n        padding-bottom: 0px;\n\n        &__message {\n            font-style: italic;\n            font-weight: normal;\n            padding-left: 20px;\n        }\n    }\n\n    .action-description-popover {\n        word-break: break-all;\n    }\n\n    button.awsui-info-button-override {\n        background: none;\n        border: none;\n        padding: 0;\n        font: inherit;\n        cursor: pointer;\n        font-size: 12px;\n        font-weight: 700;\n        line-height: 16px;\n        color: $color-text-link-default;    \n        text-decoration: none;\n        text-decoration-color: #0000;\n    }\n}\n.control-panel__unavailable {\n    padding: 20px 20px;\n}\n.control-panel__policy-error,\n.control-panel__statement-selection-warning {\n    @include control-panel-wrapper;\n    height: auto;\n    padding: 70px 10px 0;\n    border-radius: 0;\n    border: none;\n    border-left: $standard-border;\n    background-color: $standard-background-color;\n    p {\n        text-align: center;\n        b {\n            color: $color-text-heading-default;\n        }\n    }\n    p.sub-text{\n        color: $color-text-body-secondary;\n    }\n    span {\n        margin-left: auto;\n        margin-right: auto;\n    }\n}\n","@import '../../../styles/colors-list';\n@import '@amzn/awsui-design-tokens/polaris.scss';\n\n$standard-hover-background: $color-background-dropdown-item-hover;\n$standard-divider-color: $color-border-divider-default;\n$standard-background-color: $color-background-container-content;\n$standard-disabled-color: $color-background-control-disabled;\n\n$filter-input-height: 35px;\n$standard-border: 1px solid $standard-divider-color;\n$button-border:  1px solid $color-border-button-normal-default;\n$standard-border-radius: 5px;\n\n\n$ace-editor-height: 580px;\n$ace-editor-sidebar-background-color: $color-background-control-disabled;\n$policy-editor-app-height: 620px;\n$awsui-color-border-divider-default: $color-background-input-disabled;\n$awsui-color-background-control-checked: $color-background-control-checked;\n\n$awsui-color-border-input-disabled: $color-background-input-disabled;\n$awsui-popover: $color-border-divider-default;\n$orange-500: $color-background-button-primary-default;\n$space-static-m: 16px;\n$space-static-s: 12px;\n\n.policy-editor {\n    @mixin opacity($level) {\n        filter: alpha(opacity=$level * 100);\n        -moz-opacity: $level;\n        -khtml-opacity: $level;\n        opacity: $level;\n    }\n    @import './control-panel';\n    @import './editor-panel';\n    @import './modal-footer';\n    @import './resizable-panels';\n    @import './modal';\n    @import './services-actions-containers';\n\n    .policy-editor-container * {\n      box-sizing: border-box;\n    }\n\n    div.awsui-form-field-control.col-xxxs-12.col-xs-9 {\n        flex: 0 0 100%;\n        max-width: 100%;\n        .awsui.awsui-grid.col-xxxs-12.col-xs-9 {\n            flex: 0 0 100%;\n            max-width: 100%;\n        }\n    }\n\n    #root {\n        margin: 0;\n        height: 100%;\n        overflow: hidden;\n    }\n\n    a,\n    button {\n        text-decoration: none;\n    }\n\n    .hide {\n        display: none;\n        visibility: hidden;\n    }\n\n    .show {\n        display: block;\n        visibility: visible;\n        padding-top: 0px;\n\n        &.services-container__list-item {\n            padding-top: 0.5rem;\n        }\n    }\n\n    .pointer {\n        cursor: pointer;\n    }\n    .awsui-popover {\n        .learn-more-link {\n            white-space: normal;\n        }\n    }\n    .action-help {\n        span {\n            white-space: normal;\n            overflow-wrap: break-word;\n            font-weight: 400;\n            color: $color-text-empty;\n        }\n        a {\n            span.awsui-icon.awsui-icon-size-normal.awsui-icon-variant-normal {\n                padding: -0rem 0;\n                margin-top: -1px;\n            }\n        }\n        padding-bottom: 5px;\n    }\n    .learn-more-link {\n        white-space: nowrap;\n    }\n\n    .control-panel-container {\n        padding: 0;\n    }\n\n    .editor-panel-container {\n        padding-right: 0;\n        padding-left: 0;\n        border-radius: 0;\n    }\n\n    // ACE EDITOR REMOVE RESOURCE MODAL\n    .remove-resource-modal {\n        .ace_layer.ace_text-layer,\n        .ace_gutter-cell {\n            opacity: 0.6;\n        }\n    }\n\n    .awsui-util-color-secondary {\n        color: $color-text-body-secondary !important;\n    }\n}\n","$color-charts-red-300: var(--color-charts-red-300-6w142c, #ea7158);\n$color-charts-red-400: var(--color-charts-red-400-1h56i9, #dc5032);\n$color-charts-red-500: var(--color-charts-red-500-48nrh6, #d13313);\n$color-charts-red-600: var(--color-charts-red-600-ys2rt4, #ba2e0f);\n$color-charts-red-700: var(--color-charts-red-700-6pbor5, #a82a0c);\n$color-charts-red-800: var(--color-charts-red-800-ksxvuz, #972709);\n$color-charts-red-900: var(--color-charts-red-900-unqo0j, #892407);\n$color-charts-red-1000: var(--color-charts-red-1000-njz5pv, #7d2105);\n$color-charts-red-1100: var(--color-charts-red-1100-yfli8a, #721e03);\n$color-charts-red-1200: var(--color-charts-red-1200-g6spfj, #671c00);\n$color-charts-orange-300: var(--color-charts-orange-300-q7r5t4, #e07941);\n$color-charts-orange-400: var(--color-charts-orange-400-gt0ubb, #cc5f21);\n$color-charts-orange-500: var(--color-charts-orange-500-tww0h4, #bc4d01);\n$color-charts-orange-600: var(--color-charts-orange-600-w1dvkq, #a84401);\n$color-charts-orange-700: var(--color-charts-orange-700-usfzsx, #983c02);\n$color-charts-orange-800: var(--color-charts-orange-800-zifehw, #8a3603);\n$color-charts-orange-900: var(--color-charts-orange-900-3qq1sk, #7e3103);\n$color-charts-orange-1000: var(--color-charts-orange-1000-xmetqj, #732c02);\n$color-charts-orange-1100: var(--color-charts-orange-1100-6kj7wc, #692801);\n$color-charts-orange-1200: var(--color-charts-orange-1200-4cjufs, #602400);\n$color-charts-yellow-300: var(--color-charts-yellow-300-7kytav, #b2911c);\n$color-charts-yellow-400: var(--color-charts-yellow-400-6007fi, #9c7b0b);\n$color-charts-yellow-500: var(--color-charts-yellow-500-tc8hpc, #8a6b05);\n$color-charts-yellow-600: var(--color-charts-yellow-600-edd54k, #7b5f04);\n$color-charts-yellow-700: var(--color-charts-yellow-700-2bl6cq, #6f5504);\n$color-charts-yellow-800: var(--color-charts-yellow-800-i3mw9e, #654d03);\n$color-charts-yellow-900: var(--color-charts-yellow-900-7nnjy6, #5d4503);\n$color-charts-yellow-1000: var(--color-charts-yellow-1000-tdf02z, #553f03);\n$color-