var(--space-static-xs-ro517s, 8px);\n$space-static-s: var(--space-static-s-c6mo7b, 12px);\n$space-static-m: var(--space-static-m-3iypoy, 16px);\n$space-static-l: var(--space-static-l-tu9fgz, 20px);\n$space-static-xl: var(--space-static-xl-cq1tvr, 24px);\n$space-static-xxl: var(--space-static-xxl-k1zwmj, 32px);\n$space-static-xxxl: var(--space-static-xxxl-qe5u3q, 40px);\n$shadow-card: var(--shadow-card-t5xeoe, 0 1px 1px 0 rgba(0, 28, 36, 0.3), 1px 1px 1px 0 rgba(0, 28, 36, 0.15), -1px 1px 1px 0 rgba(0, 28, 36, 0.15));\n$shadow-container-active: var(--shadow-container-active-dr2bv9, 0px 4px 8px rgba(0, 28, 36, 0.45));","$gutter-padding-left: 24px;\n$gutter-padding-right: 16px;\n$space-static-xs: 8px;\n\n.editor-panel-asgard {\n    @include control-panel-wrapper;\n\n    padding: 1px 0 0 0px;\n    border-radius: 0;\n    border: none;\n    border-left: $standard-border;\n    border-top: $standard-border;\n\n    #ace-editor {\n        font-family: Monaco, Menlo, Consolas, 'Courier Prime', Courier, 'Courier New', monospace;\n        font-size: 14px;\n        line-height: 20px;\n    }\n\n    //Ace editor styles shamelessly copied from: https://code.amazon.com/packages/AWS-UI-Components/blobs/mainline-3.0/--/src/code-editor/ace-editor.scss\n    //https://polaris.a2z.com/components/awsui-code-editor/?example=javascript-sample\n    .ace_fold-widget {\n        /* A good test case for disabled folds\n           <<html<<<<\n           </html>\n        */\n        width: $gutter-padding-right - 2 * 1px; // gutter padding - 1px margin each side\n        margin-right: -$gutter-padding-right + 1px; // leave 1px margin on each side\n        background-color: transparent;\n        border: none;\n        box-shadow: none;\n    }\n\n    $active-line-border-color-light: #d5dbdb;\n    $active-line-border-color-dark: #687078;\n\n    .ace_marker-layer > .ace_active-line {\n        background: transparent;\n        box-sizing: border-box;\n        border-top: 1px solid $standard-border;\n        border-bottom: 1px solid $standard-border;\n    }\n\n    .ace_gutter {\n        background-color: $color-background-layout-main;\n        color: $color-text-body-default;\n    }\n\n    .ace_fold-widget.ace_open {\n        background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%23545b64' stroke='%23545b64' stroke-width='2' viewBox='0 0 16 16'%3E%3Cpath stroke-linejoin='round' d='M4 5h8l-4 6-4-6z'/%3E%3C/svg%3E\");\n\n        &:hover {\n            background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%2316191f' stroke='%2316191f' stroke-width='2' viewBox='0 0 16 16'%3E%3Cpath stroke-linejoin='round' d='M4 5h8l-4 6-4-6z'/%3E%3C/svg%3E\");\n        }\n    }\n\n    .ace_fold-widget.ace_closed {\n        background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%23545b64' stroke='%23545b64' stroke-linejoin='round' stroke-width='2' viewBox='0 0 16 16'%3E%3Cpath d='M5 4v8l6-4-6-4z'/%3E%3C/svg%3E\");\n\n        &:hover {\n            background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='%2316191f' stroke='%2316191f' stroke-linejoin='round' stroke-width='2' viewBox='0 0 16 16'%3E%3Cpath d='M5 4v8l6-4-6-4z'/%3E%3C/svg%3E\");\n        }\n    }\n\n    .ace_gutter-cell {\n        padding-left: $gutter-padding-left;\n        padding-right: $gutter-padding-right;\n        font-size: 15px;\n\n        &.ace_error,\n        &.ace_warning,\n        &.ace_info,\n        &.linter_finding_error,\n        &.linter_finding_security_warning,\n        &.linter_finding_warning,\n        &.linter_finding_suggestion {\n            cursor: pointer;\n\n            background-repeat: no-repeat;\n            background-size: $gutter-padding-right $gutter-padding-right;\n            background-position: 4px 2px;\n        }\n\n        &.linter_finding_suggestion {\n            color: $awsui-color-grey-600;\n            background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill-opacity='0' stroke='%23545b64' stroke-linejoin='round' stroke-width='2' viewBox='0 0 16 16'%3E%3Cpath fill='none' d='M6 14h4'/%3E%3Cpath fill='none' d='M8 11h1c0-1.53 3-2.46 3-5.24.02-1.36-.61-2.4-1.57-3.09a4.208 4.208 0 0 0-4.86 0C4.61 3.36 3.98 4.4 4 5.76 4 8.54 7 9.47 7 11h1Z'/%3E%3C/svg%3E\");\n            background-position: 5%;\n        }\n\n        &.ace_error,\n        &.linter_finding_error {\n            color: $awsui-color-red-600;\n            background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill-opacity='0' stroke='%23d13212' stroke-linejoin='round' stroke-width='2' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='none'/%3E%3Cpath fill='none' d='m10.828 5.172-5.656 5.656m5.656 0L5.172 5.172'/%3E%3C/svg%3E\");\n            background-position: 5%;\n        }\n\n        &.linter_finding_security_warning {\n            color: $security-warning-color;\n            //background-image: svg-load('../assets/svgs/security-warning.svg', stroke=$security-warning-color);\n            background-position: 5%;\n        }\n\n        &.linter_finding_warning {\n            color: $awsui-color-red-600;\n            background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill-opacity='0' stroke='%23d13212' stroke-linejoin='round' stroke-width='2' viewBox='0 0 16 16'%3E%3Cpath fill='none' d='m8 1 7 14H1L8 1z'/%3E%3Cpath fill='none' d='M7.99 12H8v.01h-.01zM8 6v4'/%3E%3C/svg%3E\");\n            background-position: 5%;\n        }\n    }\n\n    .ace_gutter-active-line {\n        background-color: $awsui-color-grey-550;\n        color: $color-background-container-content;\n\n        &.ace_error,\n        &.linter_finding_error {\n            color: $color-background-container-content;\n            background-image: url(\"data:image/svg+xml;charset=utf-8,