{\\"headline\\": \\"AWS expands resource control policies (RCPs) support to two additional services\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/aws-resource-control-policies-additional-services\\", \\"postDateTime\\": \\"06/19/2025\\", \\"absoluteDateTime\\": \\"2025-06-19T13:00:00-04:00\\"}, \\"característica3\\": {\\"headline\\": \\"AWS IAM now enforces MFA for root users across all account types\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/aws-iam-mfa-root-users-across-all-account-types/\\", \\"postDateTime\\": \\"06/17/2025\\", \\"absoluteDateTime\\": \\"2025-06-17T10:00:00-04:00\\"}, \\"característica4\\": {\\"headline\\": \\"Amazon EKS Pod Identity simplifies the experience for cross-account access\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/amazon-eks-pod-identity-cross-account-access\\", \\"postDateTime\\": \\"06/12/2025\\", \\"absoluteDateTime\\": \\"2025-06-12T13:00:00-05:00\\"}, \\"característica5\\": {\\"headline\\": \\"Amazon EBS now supports additional resource-level permissions for copying EBS snapshots\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/04/amazon-ebs-additional-resource-level-permissions-copying-eb-snapshots\\", \\"postDateTime\\": \\"04/22/2025\\", \\"absoluteDateTime\\": \\"2025-04-22T15:15:00-04:00\\"}, \\"característica6\\": {\\"headline\\": \\"AWS Identity and Access Management now supports dual-stack (IPv4 and IPv6) environments\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-identity-access-management-dual-stack-ipv4-ipv6-environments\\", \\"postDateTime\\": \\"03/28/2025\\", \\"absoluteDateTime\\": \\"2025-03-28T16:40:00-04:00\\"}, \\"característica7\\": {\\"headline\\": \\"AWS Service Reference Information now supports resources and condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-service-reference-information-resources-condition-keys\\", \\"postDateTime\\": \\"03/13/2025\\", \\"absoluteDateTime\\": \\"2025-03-13T13:00:00-04:00\\"}, \\"característica8\\": {\