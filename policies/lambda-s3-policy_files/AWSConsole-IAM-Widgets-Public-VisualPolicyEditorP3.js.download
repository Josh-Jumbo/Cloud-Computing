,"bucketPolicy":"Kebijakan bucket","principal.aws":"Akun AWS","principal.CanonicalUser":"Pengguna Canonical","principal.Federated":"Pengguna Federasi","error":"Kesalahan","error.accessDenied":"Akses Ditolak","error.internalError":"Kesalahan Internal","isPublic":"Akses publik","true":"benar","false":"salah","externalPrincipal":"Principal Eksternal","previewStatus":"Pratinjau status","condition":"Kondisi","sharedThrough":"Dibagikan melalui","accessLevel":"Tingkat akses","findingID":"Menemukan ID di IAM Access Analyzer","details.description1.allPrincipals":"Semua Principal","an":"Sebuah ","withCondition":" dengan kondisi.","has":" memiliki ","have":" memiliki ","noLonger":" tidak lagi","access":" akses","details.archived.footer1":"Temuan ini cocok dengan aturan arsip.","details.archived.footer2":" Lihat aturan arsip IAM Access Analyzer","details.lessPermissions.footer1":"Principal ini akan memiliki lebih sedikit izin setelah disimpan. ","details.lessPermissions.footer2":"Lihat detail akses di IAM Access Analyzer ","allLabel":"Semua","newLabel":"Baru","changedLabel":"Berubah","resolvedLabel":"Diselesaikan","archivedLabel":"Diarsipkan","existingLabel":"Ada","publicLabel":"Publik","activeLabel":"Aktif","ConflictException":"IAM Access Analyzer tidak dapat membuat pratinjau akses karena status penganalisis ","analyzerCreating":"membuat. ","analyzerDisabled":"dinonaktifkan. ","analyzerFailed":"gagal. ","ConflictException3":"Muat ulang halaman ini untuk memilih penganalisis yang aktif.","ThrottlingException":"Terlalu banyak permintaan","ResourceNotFoundException":"Pratinjau IAM Access tidak ditemukan. Pilih pratinjau untuk membuat pratinjau akses baru.","InternalServerException":"Kesalahan tidak diketahui. Coba lagi nanti","ServiceQuotaExceededException":"IAM Access Analyzer tidak dapat membuat pratinjau akses. Anda telah mencapai batas jumlah pratinjau akses untuk penganalisis yang dipilih. ","learnMoreServiceQuota":"Pelajari lebih lanjut tentang service quotas","bucketPolic