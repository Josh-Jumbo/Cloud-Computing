rSubHeader":"要预览对存储桶的外部访问，请在您的存储桶区域中创建一个分析器 ","goToAnalyzerButton":"转至 Access Analyzer","blockedPermissionHeader":"您无权查看 Access Analyzer 结果","blockedPermissionsSubHeader":"您或您的 AWS 管理员必须对您的权限进行更新以包括 ","permissionsRequired":"所需的权限","blockedPermissionsSubHeader2":" 以使用 IAM Access Analyzer。在您获取所需的权限之后，请选择 ","refresh":"刷新","footer":" 了解更多有关 ","accessAnalyzerPermissions":"Access Analyzer 权限 ","apiResponse":"API 响应","scan":"扫描","rescan":"重新扫描","outOfSync":"由于策略变更，结果并非最新结果。请选择“预览”以更新报告。","policyIncomplete":"策略必须完整，然后才能预览存储桶访问权限。","policySyntaxError":"所有语法错误解决之后，才能报告结果。","preview":"预览","lastScan":"上次更新时间","previewAndValidate":"预览并验证对您的资源的外部访问的 Access Analyzer 结果。","scanningForFindings":"创建访问预览报告","creatingPreviewReport":"创建访问预览报告","noFindingsFound":"未找到结果","noArchivedFindingsFound":"无已存档结果","noResolvedFindingsFound":"无已解决结果","noNewFindingsFound":"无新结果","noExistingFindingsFound":"无现有结果","noFindings":"无结果","noMatches":"未找到匹配项","reported":" 已报告","noFindingsReported":"未报告结果","existingErrorFinding":"现有的错误结果。","newErrorFinding":"新的错误结果。","searchAllFindings":"筛选所有结果","searchNewFindings":"筛选新结果","searchResolvedFindings":"筛选已解决结果","searchArchivedFindings":"筛选已存档结果","searchExistingFindings":"筛选现有结果","clearFilterButton":"清除筛选条件","groupPropertyText":"属性","and":"和","analyserStatusCreating":"正在创建","analyserStatusFailed":"失败","analyserStatusDisabled":"已禁用","analyserZoneOfTrust":"信任区","accountAnalyserLabel":"当前账户","organizationAnalyserLabel":"当前组织","orgUnitAnalyserLabel":"组织单位(OU)","principalArn":"主体 ARN","orgId":"主体 OrgID","orgPaths":"主体 Org 路径","sourceAccount":"源账户","sourceArn":"源 ARN","sourceIp":"源 IP","sourceVpc":"源 VPC","sourceVpce":"源 VPCE","userId":"用户 ID","kmsKey":"KMS 密钥 ID","googleAud":"Google 受众","cognitoAud":"Cognito 受众","callerAccount":"发起人账户","facebookAppId":"Facebook 应用程序 ID","amazonAppId":"Amazon 应用程序 ID","lambdaEventSourceToken":"Lambda 事件源令牌","accessPoint":"接入点","bucketACL":"存储桶 ACL","bucketPolicy":"存储桶策略","principal.aws":"AWS 账户","principal.CanonicalUser":"规范用户","principal.Federated":"联合身份用户","error":"错误","error.accessDenied":"访问被拒绝","error.internalError":"内部错误","isPublic":"公有访问","true":"true","false":"false","externalPrincipal":"外部主体","previewStatus":"状态预览","condition":"条件","sharedThrough":"共享途径","accessLevel":"访问级别","findingID":"IAM Access Analyzer 中的结果 ID","details.description1.allPrincipals":"所有主体","an":"An ","withCondition":" 有一个条件。","has":" 具有 ","have":" 具有 ","noLonger":" 不再","access":" 访问","details.archived.footer1":"该结果与存档规则匹配。","details.archived.footer2":" 查看 IAM Access Analyzer 存档规则","details.lessPermissions.footer1":"一旦保存之后，此主体的权限将减少。","details.lessPermissions.footer2":"请参阅 IAM Access Analyzer 中的访问详细信息 ","allLabel":"所有","newLabel":"新","changedLabel":"已更改","resolvedLabel":"已解决","archivedLabel":"已存档","existingLabel":"现有","publicLabel":"公有","activeLabel":"活动","ConflictException":"IAM Access Analyzer 无法创建访问预览，因为分析器的状态为 ","analyzerCreating":"正在创建。","analyzerDisabled":"已禁用。","analyzerFailed":"失败。","ConflictException3":"重新加载此页面以选择活动分析器。","ThrottlingException":"请求过多","ResourceNotFoundException":"找不到 IAM 访问预览。选择预览以创建新的访问预览。","InternalServerException":"未知错误。请稍后再试","ServiceQuotaExceededException":"IAM Access Analyzer 无法创建访问预览。您已达到所选分析器的访问预览次数限制。","learnMoreServiceQuota":"了解更多有关服务配额的信息","bucketPolicySizeExceeded":"存储桶策略的大小限制为 20 KB。","ValidationException":"由于资源配置无效，IAM Access Analyzer 无法创建访问预览。出现此情况可能由于以下原因之一： ","ValidationExceptionR1":"您的存储桶策略无效。有关写入存储桶策略的提示，请参阅 ","bucketPolicyLink":"https://docs.aws.amazon.com/console/s3/using-iam-policies","ValidationExceptionR2":"您的存储桶策略与存储桶 ARN 不匹配","internalError":"由于内部错误，IAM Access Analyzer 无法创建访问预览。请稍后再试。","accessPreviewId":"访问预览 ID:"}')},94158:(e,t,a)=>{e.exports=a.p+"64a5f4d62507d032038dcd76d15188e1.js"},94172:(e,t,a)=>{var o=a(93071),r=a(81519),i=a(1958);e.exports=function(e,t){var a=null==e?null:void 0!==o&&r(e)||e["@@iterator"];if(null!=a){var n,s,l,c,u=[],d=!0,p=!1;try{if(l=(a=a.call(e)).next,0===t){if(Object(a)!==a)return;d=!1}else for(;!(d=(n=l.call(a)).done)&&(i(u).call(u,n.value),u