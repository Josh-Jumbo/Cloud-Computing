bels--security-warning{color:var(--color-charts-status-critical-9eb4rk, #7d2105);font-weight:bold}.policy-linter__tabs-labels--security-warning:hover,.policy-linter__tabs-labels--security-warning--active{border-bottom:2px solid var(--color-charts-status-critical-9eb4rk, #7d2105)}.policy-linter__tabs-content__container{padding:8px}.policy-linter__tabs-content__container #access-preview-widget{margin:0}.policy-linter__tabs-content__container #permissiveness-widget{margin:0}.policy-linter__tabs-content__container .policy-linter-findings-close-button{float:right}.policy-linter__tabs-content__container .policy-linter-findings-filter-container{align-items:center}.policy-linter__tabs-content-header{display:flex;width:100%;justify-content:space-between;padding:1rem}.policy-linter__tabs-content__container--search{width:50%;display:flex;justify-content:space-between;align-items:center}.policy-linter__tabs-content__container--search-input{width:94%}.policy-linter__tabs-content__container--search input::placeholder{color:var(--color-text-input-placeholder-2f87tz, #687078)}.policy-linter__tabs-content__container--search input:-ms-input-placeholder{color:var(--color-text-input-placeholder-2f87tz, #687078)}.policy-linter__tabs-content__container--search input::-ms-input-placeholder{color:var(--color-text-input-placeholder-2f87tz, #687078)}.policy-linter__tabs-content__container--close{display:flex;align-items:center;justify-content:space-between}.policy-linter__tabs-content__container--close-icon{margin-left:5px}.policy-linter__tabs-content__container--close-icon .awsui-icon:hover{cursor:pointer}.policy-linter__tabs-content-findings-table{width:100%;min-height:4rem;resize:vertical;overflow-y:scroll}.policy-linter__tabs-content-findings-table__empty-results{text-align:center}.policy-linter__tabs-content-findings-table__empty-results-clear-button{margin-bottom:4px}.policy-linter__tabs-content-findings-table-row{padding:.3rem 0 .3rem 1.2rem;border:1px solid rgba(0,0,0,0)}.policy-linter__tabs-content-findings-table-row:hover{cursor:pointer;border:1px solid #687078;background-color:var(--color-background-input-disabled-ng50ec, #eaeded)}.policy-linter__tabs-content-findings-table-row--clicked{background-color:var(--color-background-item-selected-as5a6y, #f1faff);border:1px solid var(--color-border-item-selected-i24nhv, #0073bb)}.policy-linter__tabs-content-findings-table-row__line{display:inline-block;width:10rem;padding-right:.5rem;vertical-align:middle}.policy-linter__tabs-content-findings-table-row__line--extra-width{width:18rem}.policy-linter__tabs-content-findings-table-row__line-message{font-weight:500}.policy-linter__tabs-content-findings-table-row__line-popover-text{color:var(--color-text-empty-8nixxe, #687078)}.policy-linter__tabs-content-findings-table-row__line-popover-list{list-style-type:none}.policy-linter__tabs-content-findings-table-row__message{display:inline-block;width:80%;vertical-align:middle}","",{version:3,sources:["webpack://./src/widgets/PolicyLinterP3/index.scss","webpack://./node_modules/@amzn/awsui-design-tokens/polaris.scss"],names:[],mappings:"AAUA,YACE,wBAAA,CAIF,eACE,0ECiLmC,CD/KnC,4EAAA,CAGA,sBACE,YAAA,CAGF,4BACE,mFAAA,CACA,kCACE,sCAzBc,CA0Bd,mBAAA,CACA,oBAAA,CACA,YAAA,CACA,uCACE,oBAAA,CACA,uDCgPqB,CD/OrB,4BAAA,CACA,6CACE,cAAA,CAEF,mDACE,gCAAA,CAGA,+HACE,WAAA,CACA,UAAA,CACA,qBAAA,CAGJ,6CACE,iCA9CgB,CA+ChB,oDC4PgB,CDxPpB,4CACE,4DCiS0B,CDhS1B,kDACE,cAAA,CAGJ,4CACE,gBAAA,CACA,gBAAA,CACA,mDC8QiB,CD5QjB,iDACE,iCA/DgB,CAgEhB,uDACE,6EAAA,CAKF,4DACE,6EAAA,CAIN,qEACE,aAAA,CACA,6BAAA,CAGJ,mCACE,oDC2RoB,CD1RpB,gBAAA,CACA,oFACE,sEAAA,CAGJ,qCACE,sDCwRsB,CDvRtB,gBAAA,CACA,wFACE,wEAAA,CAGJ,wCACE,sDC6MsB,CD5MtB,gBAAA,CACA,8FACE,wEAAA,CAGJ,8CACE,yDChByB,CDiBzB,gBAAA,CACA,0GACE,2EAAA,CAOJ,wCACE,WA9GY,CAgHZ,+DACE,QAAA,CAGF,+DACE,QAAA,CAGF,6EACE,WAAA,CAEF,iFACE,kBAAA,CAIJ,oCACE,YAAA,CACA,UAAA,CACA,6BAAA,CACA,YAAA,CAGF,gDACE,SAAA,CACA,YAAA,CACA,6BAAA,CACA,kBAAA,CACA,sDACE,SAAA,CAEF,mEACE,yDC+LuB,CD3LzB,4EACE,yDC0LuB,CDtLzB,6EACE,yDCqLuB,CDjL3B,+CACE,YAAA,CACA,kBAAA,CACA,6BAAA,CACA,oDACE,eAAA,CAEE,sEACE,cAAA,CAMR,4CACE,UAAA,CACA,eAAA,CACA,eAAA,CACA,iBAAA,CACA,2DACE,iBAAA,CACA,wEACE,iBAAA,CAGJ,gDACE,4BAzLc,CA0Ld,8BAAA,CACA,sDACE,cAAA,CACA,wBAAA,CAEA,uECOwB,CDJ1B,yDACE,sECIuB,CDHvB,kEAAA,CAGF,sDACE,oBAAA,CACA,WAAA,CACA,mBAAA,CACA,qBAAA,CACA,mEACE,WAAA,CAEF,8DACE,eAAA,CAGA,mEACE,6CC8GK,CD5GP,mEACE,oBAAA,CAIN,yDACE,oBAAA,CACA,SAAA,CACA,qBAAA",sourcesContent:["@import './../../styles/colors-list';\n@import '@amzn/awsui-design-tokens/polaris.scss';\n\n$tabs-list-padding: 0.8rem 0.3rem 0.8rem 0 !important;\n$tabs-label-text-padding: 0.6rem 1.2rem 0.8rem 1.2rem;\n$clear-search-button-padding: 1rem 0 2rem 0;\n$finding-row-padding: 0.3rem 0 0.3rem 1.2rem;\n$space-static-xs: 8px;\n\n// Making all icons inherit it's container colors.\n.awsui-icon {\n  color: inherit !important;\n}\n\n// Refer to colors-list.scss on why each color is repeated twice\n.policy-linter {\n  background-color: $color-background-container-content;\n  \n  border: 1px solid $color-border-button-primary-disabled;\n \n\n  &--error {\n    padding: 2rem;\n  }\n\n  &__tabs-labels {\n    border-bottom: 1px solid $color-border-button-primary-disabled;\n    &__list {\n      padding: $tabs-list-padding;\n      margin: 0 !important;\n      list-style-type: none;\n      display: flex;\n      &-item {\n        display: inline-block;\n        color: $color-border-container-top;\n        padding-top: 0.3rem !important;\n        &:hover {\n          cursor: pointer;\n        }\n        .awsui-icon {\n          vertical-align: bottom !important;\n        }\n        .suggestions-icon, .security-warning-icon {\n          svg {\n            height: 16px;\n            width: 16px;\n            vertical-align: middle;\n          }\n        }\n        &__text {\n          padding: $tabs-label-text-padding;\n          color: $color-text-body-default;\n        }\n\n      }\n      .disabled {\n        color: $color-text-interactive-disabled;\n        &:hover {\n          cursor: default;\n        }\n      }\n      .ante-tab {\n        font-weight: bold;\n        margin-left: auto;\n        color: $color-text-group-label;\n        \n        span {\n          padding: $tabs-label-text-padding;\n          &:hover {\n            border-bottom: 2px solid $color-text-interactive-default;\n          }\n        }\n\n        &.active-tab {\n          span {\n            border-bottom: 2px solid $color-text-interactive-default;\n          }\n        }\n      }\n      .ante-tab:not(.first-external-tab){\n        margin-left: 0; \n        border-left: solid #D5DBDB 1px;\n      }\n    }\n    &--error {\n      color: $color-text-status-error;\n      font-weight: bold;\n      &:hover, &--active{\n        border-bottom: 2px solid $color-text-status-error;\n      }\n    }\n    &--warning {\n      color: $color-text-status-warning;\n      font-weight: bold;\n      &:hover, &--active{\n        border-bottom: 2px solid $color-text-status-warning;        \n      }\n    }\n    &--suggestion {\n      color: $color-text-body-secondary;     \n      font-weight: bold;\n      &:hover, &--active {\n        border-bottom: 2px solid $color-text-body-secondary;        \n      }\n    }\n    &--security-warning {\n      color: $color-charts-status-critical;\n      font-weight: bold;\n      &:hover, &--active {\n        border-bottom: 2px solid $color-charts-status-critical;\n      }\n    }\n  }\n\n  &__tabs-content {\n\n    &__container {\n      padding: $space-static-xs;\n\n      #access-preview-widget {\n        margin: 0;\n      }\n\n      #permissiveness-widget {\n        margin: 0;\n      }\n\n      .policy-linter-findings-close-button {\n        float: right;\n      }\n      .policy-linter-findings-filter-container {\n        align-items: center;\n      }\n    }\n\n    &-header {\n      display: flex;\n      width: 100%;\n      justify-content: space-between;\n      padding: 1rem;\n    }\n\n    &__container--search {\n      width: 50%;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      &-input {\n        width: 94%;\n      }\n      input::placeholder {\n        color: $color-text-input-placeholder;\n       \n      }\n\n      input:-ms-input-placeholder { /* Internet Explorer 10-11 */\n        color: $color-text-input-placeholder;\n      \n      }\n\n      input::-ms-input-placeholder { /* Microsoft Edge */\n        color: $color-text-input-placeholder;\n      }\n    }\n\n    &__container--close {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      &-icon {\n        margin-left: 5px;\n        .awsui-icon {\n          &:hover {\n            cursor: pointer;\n          }\n        }\n      }\n    }\n\n    &-findings-table {\n      width: 100%;\n      min-height: 4rem;\n      resize: vertical;\n      overflow-y: scroll;\n      &__empty-results {\n        text-align: center;\n        &-clear-button {\n          margin-bottom: 4px;\n        }\n      }\n      &-row {\n        padding: $finding-row-padding;\n        border: 1px solid transparent;\n        &:hover {\n          cursor: pointer;\n          border: 1px solid $awsui-color-grey-550;\n          \n          background-color: $color-background-input-disabled;\n          \n        }\n        &--clicked {\n          background-color: $color-background-item-selected;\n          border: 1px solid $color-border-item-selected;\n          \n        }\n        &__line {\n          display: inline-block;\n          width: 10rem;\n          padding-right: 0.5rem;\n          vertical-align: middle;\n          &--extra-width {\n            width: 18rem;\n          }\n          &-message {\n            font-weight: 500;\n          }\n          &-popover {\n            &-text {\n              color: $color-text-empty;\n            }\n            &-list {\n              list-style-type: none;\n            }\n          }\n        }\n        &__message {\n          display: inline-block;\n