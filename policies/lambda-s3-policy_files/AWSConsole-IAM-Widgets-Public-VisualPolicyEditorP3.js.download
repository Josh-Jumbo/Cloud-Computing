headline\\": \\"AWS expands resource control policies (RCPs) support to two additional services\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/aws-resource-control-policies-additional-services\\", \\"postDateTime\\": \\"06/19/2025\\", \\"absoluteDateTime\\": \\"2025-06-19T13:00:00-04:00\\"}, \\"feature3\\": {\\"headline\\": \\"AWS IAM now enforces MFA for root users across all account types\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/aws-iam-mfa-root-users-across-all-account-types/\\", \\"postDateTime\\": \\"06/17/2025\\", \\"absoluteDateTime\\": \\"2025-06-17T10:00:00-04:00\\"}, \\"feature4\\": {\\"headline\\": \\"Amazon EKS Pod Identity simplifies the experience for cross-account access\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/amazon-eks-pod-identity-cross-account-access\\", \\"postDateTime\\": \\"06/12/2025\\", \\"absoluteDateTime\\": \\"2025-06-12T13:00:00-05:00\\"}, \\"feature5\\": {\\"headline\\": \\"Amazon EBS now supports additional resource-level permissions for copying EBS snapshots\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/04/amazon-ebs-additional-resource-level-permissions-copying-eb-snapshots\\", \\"postDateTime\\": \\"04/22/2025\\", \\"absoluteDateTime\\": \\"2025-04-22T15:15:00-04:00\\"}, \\"feature6\\": {\\"headline\\": \\"AWS Identity and Access Management now supports dual-stack (IPv4 and IPv6) environments\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-identity-access-management-dual-stack-ipv4-ipv6-environments\\", \\"postDateTime\\": \\"03/28/2025\\", \\"absoluteDateTime\\": \\"2025-03-28T16:40:00-04:00\\"}, \\"feature7\\": {\\"headline\\": \\"AWS Service Reference Information now supports resources and condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-service-reference-information-resources-condition-keys\\", \\"postDateTime\\": \\"03/13/2025\\", \\"absoluteDateTime\\": \\"2025-03-13T13:00:00-04:00\\"}, \\"feature8\\": {\\"headline\\": \\"IAM Access Analyzer now supports Internet Protocol Version 6 (IPv6)\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/iam-access-analyzer-supports-ipv6/\\", \\"postDateTime\\": \\"03/05/2025\\", \\"absoluteDateTime\\": \\"2025-03-05T10:00:00-08:00\\"}, \\"feature9\\": {\\"headline\\": \\"Amazon RDS now provides visibility into IAM DB Authentication metrics and logs\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/amazon-rds-visibility-iam-db-authentication-metrics-logs\\", \\"postDateTime\\": \\"02/26/2025\\", \\"absoluteDateTime\\": \\"2025-02-26T17:00:00-05:00\\"}, \\"feature10\\": {\\"headline\\": \\"Amazon ECS adds support for additional IAM condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/amazon-ecs-additional-iam-condition-keys\\", \\"postDateTime\\": \\"02/26/2025\\", \\"absoluteDateTime\\": \\"2025-02-26T13:00:00-05:00\\"}, \\"feature11\\": {\\"headline\\": \\"AWS IAM announces support for encrypted SAML assertions \\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/aws-iam-encrypted-saml-assertions/\\", \\"postDateTime\\": \\"02/05/2025\\", \\"absoluteDateTime\\": \\"2025-02-05T10:00:00-08:00\\"}, \\"feature12\\": {\\"headline\\": \\"AWS CodeBuild announces support for project ARN and build ARN IAM condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/01/aws-codebuild-project-arn-build-arn-iam-condition-keys\\", \\"postDateTime\\": \\"01/28/2025\\", \\"absoluteDateTime\\": \\"2025-01-28T16:50:00-05:00\\"}, \\"feature13\\": {\\"headline\\": \\"IAM Roles Anywhere credential helper now supports TPM 2.0\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/12/iam-roles-anywhere-credential-helper-tpm-2-0\\", \\"postDateTime\\": \\"12/17/2024\\", \\"absoluteDateTime\\": \\"2024-12-17T14:50:00-05:00\\"}, \\"feature14\\": {\\"headline\\": \\"Announcing AWS STS support for ECDSA-based signatures of OIDC tokens\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/aws-sts-ecdsa-based-signatures-oidc-tokens\\", \\"postDateTime\\": \\"11/22/2024\\",