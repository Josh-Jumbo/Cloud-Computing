eadlineUrl\\": \\"/about-aws/whats-new/2025/06/amazon-eks-pod-identity-cross-account-access\\", \\"postDateTime\\": \\"06/12/2025\\", \\"absoluteDateTime\\": \\"2025-06-12T13:00:00-05:00\\"}, \\"feature5\\": {\\"headline\\": \\"Amazon EBS now supports additional resource-level permissions for copying EBS snapshots\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/04/amazon-ebs-additional-resource-level-permissions-copying-eb-snapshots\\", \\"postDateTime\\": \\"04/22/2025\\", \\"absoluteDateTime\\": \\"2025-04-22T15:15:00-04:00\\"}, \\"feature6\\": {\\"headline\\": \\"AWS Identity and Access Management now supports dual-stack (IPv4 and IPv6) environments\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-identity-access-management-dual-stack-ipv4-ipv6-environments\\", \\"postDateTime\\": \\"03/28/2025\\", \\"absoluteDateTime\\": \\"2025-03-28T16:40:00-04:00\\"}, \\"feature7\\": {\\"headline\\": \\"AWS Service Reference Information now supports resources and condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-service-reference-information-resources-condition-keys\\", \\"postDateTime\\": \\"03/13/2025\\", \\"absoluteDateTime\\": \\"2025-03-13T13:00:00-04:00\\"}, \\"feature8\\": {\\"headline\\": \\"IAM Access Analyzer now supports Internet Protocol Version 6 (IPv6)\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/iam-access-analyzer-supports-ipv6/\\", \\"postDateTime\\": \\"03/05/2025\\", \\"absoluteDateTime\\": \\"2025-03-05T10:00:00-08:00\\"}, \\"feature9\\": {\\"headline\\": \\"Amazon RDS now provides visibility into IAM DB Authentication metrics and logs\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/amazon-rds-visibility-iam-db-authentication-metrics-logs\\", \\"postDateTime\\": \\"02/26/2025\\", \\"absoluteDateTime\\": \\"2025-02-26T17:00:00-05:00\\"}, \\"feature10\\": {\\"headline\\": \\"Amazon ECS adds support for additional IAM condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/amazon-ecs-additio