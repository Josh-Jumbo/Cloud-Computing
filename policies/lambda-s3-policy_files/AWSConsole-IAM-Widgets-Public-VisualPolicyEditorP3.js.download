"Plus d\'informations sur {actionName}","policyContainsErrorSecurityWarningAndWarning":"Votre politique contient {errorCount} erreurs, {securityWarningCount} avertissements de sécurité et {warningCount} avertissements","policyContainsErrorAndSecurityWarning":"Votre politique contient {errorCount} erreurs et {securityWarningCount} avertissements de sécurité","policyContainsErrorAndWarning":"Votre politique contient {errorCount} erreurs et {warningCount} avertissements","policyContainsSecurityWarningAndWarning":"Votre politique contient {securityWarningCount} avertissements de sécurité et {warningCount} avertissements","policyContainsError":"Votre politique contient {errorCount} erreurs","policyContainsSecurityWarning":"Votre politique contient {securityWarningCount} avertissements de sécurité","policyContainsWarning":"Votre politique contient {warningCount} avertissements","filterActions":"Rechercher des actions","clearFilterActions":"Effacer le filtre et afficher toutes les actions pour le service","filterServices":"Rechercher des services","clearFilterServices":"Effacer le filtre et afficher tous les services disponibles","matches":"{count} correspondances","learnMoreAboutValidation":"En savoir plus sur la validation des politiques","clearSearchLabel":"Effacer"},"whatsNewWidget":{"features.iam":"{\\"feature0\\": {\\"headline\\": \\"Amazon Bedrock introduces API keys for streamlined development\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/07/amazon-bedrock-api-keys-for-streamlined-development\\", \\"postDateTime\\": \\"07/08/2025\\", \\"absoluteDateTime\\": \\"2025-07-08T19:34:00Z\\"}, \\"feature1\\": {\\"headline\\": \\"AWS Service Reference Information now supports annotations for service actions\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/aws-service-reference-information-annotations/\\", \\"postDateTime\\": \\"06/26/2025\\", \\"absoluteDateTime\\": \\"2025-06-26T10:00:00-07:00\\"}, \\"feature2\\": {\\"headline\\": \\"AWS expands resource control policies (RCPs) support to two additional services\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/aws-resource-control-policies-additional-services\\", \\"postDateTime\\": \\"06/19/2025\\", \\"absoluteDateTime\\": \\"2025-06-19T13:00:00-04:00\\"}, \\"feature3\\": {\\"headline\\": \\"AWS IAM now enforces MFA for root users across all account types\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/aws-iam-mfa-root-users-across-all-account-types/\\", \\"postDateTime\\": \\"06/17/2025\\", \\"absoluteDateTime\\": \\"2025-06-17T10:00:00-04:00\\"}, \\"feature4\\": {\\"headline\\": \\"Amazon EKS Pod Identity simplifies the experience for cross-account access\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/06/amazon-eks-pod-identity-cross-account-access\\", \\"postDateTime\\": \\"06/12/2025\\", \\"absoluteDateTime\\": \\"2025-06-12T13:00:00-05:00\\"}, \\"feature5\\": {\\"headline\\": \\"Amazon EBS now supports additional resource-level permissions for copying EBS snapshots\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/04/amazon-ebs-additional-resource-level-permissions-copying-eb-snapshots\\", \\"postDateTime\\": \\"04/22/2025\\", \\"absoluteDateTime\\": \\"2025-04-22T15:15:00-04:00\\"}, \\"feature6\\": {\\"headline\\": \\"AWS Identity and Access Management now supports dual-stack (IPv4 and IPv6) environments\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-identity-access-management-dual-stack-ipv4-ipv6-environments\\", \\"postDateTime\\": \\"03/28/2025\\", \\"absoluteDateTime\\": \\"2025-03-28T16:40:00-04:00\\"}, \\"feature7\\": {\\"headline\\": \\"AWS Service Reference Information now supports resources and condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/aws-service-reference-information-resources-condition-keys\\", \\"postDateTime\\": \\"03/13/2025\\", \\"absoluteDateTime\\": \\"2025-03-13T13:00:00-04:00\\"}, \\"feature8\\": {\\"headline\\": \\"IAM Access Analyzer now supports Internet Protocol Version 6 (IPv6)\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/03/iam-access-analyzer-supports-ipv6/\\", \\"postDateTime\\": \\"03/05/2025\\", \\"absoluteDateTime\\": \\"2025-03-05T10:00:00-08:00\\"}, \\"feature9\\": {\\"headline\\": \\"Amazon RDS now provides visibility into IAM DB Authentication metrics and logs\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/amazon-rds-visibility-iam-db-authentication-metrics-logs\\", \\"postDateTime\\": \\"02/26/2025\\", \\"absoluteDateTime\\": \\"2025-02-26T17:00:00-05:00\\"}, \\"feature10\\": {\\"headline\\": \\"Amazon ECS adds support for additional IAM condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/amazon-ecs-additional-iam-condition-keys\\", \\"postDateTime\\": \\"02/26/2025\\", \\"absoluteDateTime\\": \\"2025-02-26T13:00:00-05:00\\"}, \\"feature11\\": {\\"headline\\": \\"AWS IAM announces support for encrypted SAML assertions \\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/02/aws-iam-encrypted-saml-assertions/\\", \\"postDateTime\\": \\"02/05/2025\\", \\"absoluteDateTime\\": \\"2025-02-05T10:00:00-08:00\\"}, \\"feature12\\": {\\"headline\\": \\"AWS CodeBuild announces support for project ARN and build ARN IAM condition keys\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2025/01/aws-codebuild-project-arn-build-arn-iam-condition-keys\\", \\"postDateTime\\": \\"01/28/2025\\", \\"absoluteDateTime\\": \\"2025-01-28T16:50:00-05:00\\"}, \\"feature13\\": {\\"headline\\": \\"IAM Roles Anywhere credential helper now supports TPM 2.0\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/12/iam-roles-anywhere-credential-helper-tpm-2-0\\", \\"postDateTime\\": \\"12/17/2024\\", \\"absoluteDateTime\\": \\"2024-12-17T14:50:00-05:00\\"}, \\"feature14\\": {\\"headline\\": \\"Announcing AWS STS support for ECDSA-based signatures of OIDC tokens\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/aws-sts-ecdsa-based-signatures-oidc-tokens\\", \\"postDateTime\\": \\"11/22/2024\\", \\"absoluteDateTime\\": \\"2024-11-22T15:15:00-05:00\\"}, \\"feature15\\": {\\"headline\\": \\"Amazon EKS simplifies providing IAM permissions to EKS add-ons\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/amazon-eks-iam-permissions-eks-add-ons\\", \\"postDateTime\\": \\"11/18/2024\\", \\"absoluteDateTime\\": \\"2024-11-18T17:00:00-05:00\\"}, \\"feature16\\": {\\"headline\\": \\"Centrally manage root access in AWS Identity and Access Management (IAM)\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/manage-root-access-aws-identity-access-management/\\", \\"postDateTime\\": \\"11/15/2024\\", \\"absoluteDateTime\\": \\"2024-11-15T10:00:00-08:00\\"}, \\"feature17\\": {\\"headline\\": \\"Customize scope of IAM Access Analyzer unused access analysis  \\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/customize-scope-iam-access-analyzer-unused-access-analysis/\\", \\"postDateTime\\": \\"11/14/2024\\", \\"absoluteDateTime\\": \\"2024-11-14T10:00:00-08:00\\"}, \\"feature18\\": {\\"headline\\": \\"Introducing resource control policies (RCPs) to centrally restrict access to AWS resources\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/resource-control-policies-restrict-access-aws-resources/\\", \\"postDateTime\\": \\"11/13/2024\\", \\"absoluteDateTime\\": \\"2024-11-13T10:00:00-08:00\\"}, \\"feature19\\": {\\"headline\\": \\"AWS IAM now supports PrivateLink in the AWS GovCloud (US) Regions\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/11/aws-iam-privatelink-govcloud-us-regions\\", \\"postDateTime\\": \\"11/08/2024\\", \\"absoluteDateTime\\": \\"2024-11-08T13:00:00-05:00\\"}, \\"feature20\\": {\\"headline\\": \\"Streamline automation of policy management workflows with service reference information\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/10/streamline-automation-policy-management-workflows-service-reference-information\\", \\"postDateTime\\": \\"10/10/2024\\", \\"absoluteDateTime\\": \\"2024-10-10T13:00:00-04:00\\"}, \\"feature21\\": {\\"headline\\": \\"Amazon S3 Access Grants introduce the ListCallerAccessGrants API\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/09/amazon-s3-access-grants-listcalleraccessgrants-api\\", \\"postDateTime\\": \\"09/05/2024\\", \\"absoluteDateTime\\": \\"2024-09-05T17:50:00-04:00\\"}, \\"feature22\\": {\\"headline\\": \\"AWS Identity and Access Management now supports AWS PrivateLink in all commercial Regions\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/08/aws-identity-access-management-aws-privatelink-regions/\\", \\"postDateTime\\": \\"08/22/2024\\", \\"absoluteDateTime\\": \\"2024-08-22T10:00:00-07:00\\"}, \\"feature23\\": {\\"headline\\": \\"AWS Identity and Access Management simplifies management of OpenID Connect identity providers\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/07/aws-identity-access-management-open-id-connect-identity-providers\\", \\"postDateTime\\": \\"07/12/2024\\", \\"absoluteDateTime\\": \\"2024-07-12T16:30:00-04:00\\"}, \\"feature24\\": {\\"headline\\": \\"AWS IAM Access Analyzer now offers policy checks for public and critical resource access\\", \\"headlineUrl\\": \\"/about-aws/whats-new/2024/06/aws-iam-access-analyzer-policy-checks\\", \\"postDateTime\\": \\"06/11/2024\\", \\"absoluteDateTime\\": \\"2024-06-11T08:00:00-04:00\\"}}","today":" Aujourd\'hui","yesterday":" Hier","daysAgo":" Il y a {day} jours","weekAgo":" Il y a 1 semaine","weeksAgo":" Il y a {week} semaines","monthAgo":" Il y a 1 mois","monthsAgo":" Il y a {month} mois","yearAgo":" Il y a 1 an","header":"Nouveautés","description":"Mises à jour des fonctions dans IAM","viewAll":"Tout afficher","viewAllAria":"Voir tout sur les nouveautés","more":"plus","less":"moins","moreAria":"Afficher plus de résultats","lessAria":"Afficher moins de résultats"},"mfaListWidget":{"mfaListLoadingText":"Chargement en cours","mfaListTableHeader":"Authentification multifactorielle (MFA)","mfaListTableHeaderDescription":"Il est recommandé d\'utiliser MFA pour renforcer la sécurité de vos environnements AWS. La connexion à des comptes protégés par MFA nécessite un nom de personne, un mot de passe et un code d\'authentification provenant d\'un dispositif MFA.","remove":"Retirer","resync":"Resynchroniser","assignMfa":"Affecter l\'authentification MFA","noDevice":"Aucun dispositif MFA","noDeviceDescription":"Ajouter un dispositif MFA pour renforcer la sécurité de votre environnement AWS","deleteMFAModal":"Supprimer le dispositif MFA ?","deleteMFAContent":"Vous n\'êtes pas tenu de fournir des codes MFA lorsque l\'utilisateur se connecte.","cancel":"Annuler","resyncMFATitle":"Resynchroniser le dispositif MFA","resyncMFAContent":"Remplissez deux codes consécutifs à partir de votre dispositif MFA pour le resynchroniser.","resyncInput1":"Code MFA 1","resyncInput2":"Code MFA 2"},"selectMFADevice":{"virtualDesc":"S\'authentifier à l\'aide d\'un code généré par une application installée sur votre appareil mobile ou votre ordinateur.","u2fDesc":"S\'authentifier à l\'aide d\'un code généré en touchant un YubiKey ou un autre appareil U2F pris en charge.","hardwareDesc":"Authentifiez-vous à l\'aide d\'un code affiché sur un jeton mot de passe unique à durée limitée (TOTP) matériel.","authenticatorApp":"Application d\'authentification","u2fSecurityKey":"Clé de sécurité U2F","hardwareDevice":"Jeton TOTP matériel","selectDevice":"Sélectionner le dispositif MFA","selectDeviceSmall":"Sélectionnez un dispositif MFA à utiliser en plus de votre nom d\'utilisateur et de votre mot de passe chaque fois que vous devez vous authentifier.","cancel":"Annuler","next":"Suivant"},"setupMFADevice":{"pageTitle":"Activer l\'authentification multifactorielle (MFA)","setupTitle":"Configurer votre application d\'authentification","virtualDesc":"Un dispositif MFA virtuel est une application s\'exécutant sur votre appareil que vous pouvez configurer en scannant un code QR.","install":"Installez une application compatible telle que Google Authenticator, Duo Mobile ou Authy sur votre appareil mobile ou votre ordinateur.","list":"Consultez la liste des applications compatibles","show":"Afficher le code QR","step2Text":"Ouvrez votre application d\'authentification, choisissez <b>Show QR code</b> (Afficher le code QR) sur cette page, puis utilisez l\'application pour scanner le code. Vous pouvez également saisir une clé secrète. <show>Afficher la clé secrète</show>","step3Text":"Saisir deux codes MFA consécutifs ci-dessous","code1":"Saisir un code depuis votre application virtuelle ci-dessous","code2":"Patientez 30 secondes, puis saisissez un second code.","cancel":"Annuler","previous":"Précédent","addMFA":"Ajouter la MFA","hardwareTitle":"Configurer un dispositif MFA matériel","hardwareDescription":"Pour plus d\'informations sur l\'utilisation d\'un dispositif MFA matériel, veuillez consulter le <a>Guide de l\'utilisateur IAM</a>","hardwareLabel1":"Saisissez le numéro de série du dispositif situé à l\'arrière de celui-ci.","hardwareLabel2":"Appuyez sur le bouton situé à l\'avant du dispositif et saisissez le numéro à 6 chiffres qui apparaît.","hardwareLabel3":"Attendez 30 secondes, puis appuyez à nouveau sur le bouton. Saisissez le deuxième numéro.","serialNumber":"Numéro de série","MFACode1":"Code MFA 1","MFACode2":"Code MFA 2","u2fTitle":"Configurer la clé de sécurité","u2fDesc":"Configurations prises en charge pour l\'utilisation des clés de sécurité","u2fStep1":"Connectez votre clé de sécurité à votre dispositif.","u2fStep2":"Appuyez sur la clé de sécurité.","passkeySetupTitle":"Clé d’accès ou clé de sécurité","passkeySetupDesc":"Les clés d’accès vous permettent de vous connecter en toute sécurité à votre compte AWS à l’aide de votre empreinte digitale, de votre visage, du code PIN de votre appareil ou de votre clé de sécurité FIDO2.","passkeySetupStep1Label":"Étape 1 sur 2","passkeySetupStep1":"Créez une clé d’accès sur cet appareil ou, si vous utilisez un autre appareil, connectez-le maintenant.","passkeySetupStep2Label":"Étape 2 sur 2","passkeySetupStep2":"Suivez les instructions de votre navigateur.","passkeySetupLoading":"Chargement en cours","waiting":"Attente de la clé de sécurité…","tap":"Appuyez sur la touche","troubleShoot":"Dépannage de la MFA","u2fComplete":"La configuration est terminée pour cette clé de sécurité U2F","u2fCompleteText":"Il faut maintenant appuyer sur la clé de sécurité U2F pour se connecter.","done":"Terminé","wizardStep1Title":"Sélectionner le dispositif MFA","wizardStep2Title":"Configurer le dispositif","optional":"Facultatif","next":"Suivant","retry":"Réessayer","selectVirtualDesc":"S\'authentifier à l\'aide d\'un code généré par une application installée sur votre appareil mobile ou votre ordinateur.","selectU2fDesc":"Authentifiez-vous à l\'aide d\'un code généré en touchant un YubiKey ou une autre clé de sécurité FIDO prise en charge.","selectPasskeyDesc":"Authentifiez-vous à l’aide de votre empreinte digitale, de votre visage ou du verrouillage d’écran. Créez une clé d’accès sur cet appareil ou utilisez un autre appareil, comme une clé de sécurité FIDO2.","hardwareDesc":"Authentifiez-vous à l\'aide d\'un code affiché sur un jeton mot de passe unique à durée limitée (TOTP) matériel.","selectHardwareOtherDeviceDesc":"Authentifiez-vous à l’aide d’un code généré par un jeton TOTP matériel ou d’autres appareils matériels.","otherDesc":"S\'authentifier à l\'aide d\'un code affiché sur un jeton Gemalto.","authenticatorApp":"Application d\'authentification","u2fSecurityKey":"Clé de sécurité U2F","hardwareDevice":"Jeton TOTP matériel","selectDevice":"Sélectionner le dispositif MFA","selectDeviceSmall":"Sélectionnez un dispositif MFA à utiliser en plus de votre nom d\'utilisateur et de votre mot de passe chaque fois que vous devez vous authentifier.","deviceSelectionLabel":"Options de l’appareil","deviceSelectionDescription":"Outre le nom d’utilisateur et le mot de passe, vous utiliserez cet appareil pour vous authentifier sur votre compte. ","displayNameLabel":"Nom d’affichage de la clé d’accès","displayNameDescription":"Ce nom sera affiché lors de la connexion à l’aide d’une clé d’accès. Le nom suggéré par défaut peut être personnalisé si nécessaire.","displayNameDefaultSelection":"Utiliser le nom d’affichage de clé d’accès par défaut","displayNameConstraintText":"64 caractères maximum. Caractères valides : A-Z, a-z, 0-9 et + = , . @ _ - (tiret)","displayNameLengthErrorText":"Le nom d’affichage de la clé d’accès ne peut pas comporter plus de 64 caractères","displayNameRequiredErrorText":"Le nom d\'affichage de la clé d\'accès est requis","displayNameInvalidCharactersErrorText":"Caractères non valides. Utiliser des caractères valides : A-Z, a-z, 0-9 et + = , . @ _ - (tiret)","stepNumber":"Étape {stepNumber}","stepLabel":"Étape {stepNumber} sur {stepCount}","inputInValid":"L\'entrée doit être un numéro à 6 chiffres","mfaAdded":"Dispositif MFA attribué","mfaMessage":"Vous devez maintenant vous authentifier auprès de ce dispositif MFA lorsque vous vous connectez à la console AWS.","securityKey":"Clé de sécurité","passkeyOrSecurityKey":"Clé d’accès ou clé de sécurité","webAuthNError":"Impossible d\'enregistrer la clé de sécurité.","retryRequest":"Effectuez une nouvelle demande.","deviceIneligibleDesc":"Ce dispositif n\'est pas pris en charge ou a déjà été enregistré.","u2fTimeoutDesc":"Effectuer une nouvelle demande","configurationUnsupportedDesc":"Le navigateur que vous utilisez ne prend pas en charge les clés de sécurité U2F.","defaultDesc":"Contactez l\'assistance ou réessayez ultérieurement.","deviceIneligibleTitle":"Un problème est survenu avec le dispositif","u2fTimeoutTitle":"Votre demande a expiré","configurationUnsupportedTitle":"Navigateur non pris en charge","defaultTitle":"Le service rencontre des problèmes","beginRegistrationError":"Erreur lors de l\'enregistrement de la clé de sécurité","finaRegistrationError":"Erreur lors de l\'enregistrement de la clé de sécurité","specifyMFAName":"Spécifier le nom du dispositif MFA","deviceNameLabel":"Nom du dispositif","deviceNameConstraintText":"64 caractères maximum. Caractères valides : A-Z, a-z, 0-9 et + = , . @ _ - (tiret)","deviceNameDescriptionText":"Saisissez un nom explicite pour identifier ce dispositif.","deviceNameDescriptionUpdated":"Ce nom sera utilisé dans l’ARN d’identification de cet appareil.","deviceName":"Nom du dispositif","invalidName":"Nom non valide. Utiliser des caractères valides : A-Z, a-z, 0-9 et + = , . @ _ - (tiret)","mmfaMessage":"Vous pouvez enregistrer jusqu\'à 8 appareils MFA, quelle que soit la combinaison des <link1>types MFA actuellement pris en charge</link1> avec votre compte racine AWS et votre utilisateur IAM. Avec plusieurs appareils MFA, vous n\'avez besoin que d\'un seul appareil MFA pour vous connecter à la console AWS ou créer une session via l\'<link2>AWS CLI</link2> avec cette personne."},"visualEditor":{"aboutAction":"À propos de {action}","accesLevel":"Niveau d\'accès","actionAlreadyExists":"Cette action existe déjà pour le service {displayName}","actionGroupOption":{"label":"Niveau d\'accès – {actionType}","listOnly":"Liste","readOnly":"Lire","readWrite":"Écrire","permissions":"Gestion des autorisations","tagging":"Étiquetage","wildCards":"Actions manuelles","unknown":"Actions non reconnues"},"actionInfoButtonLabel":"Bouton d\'informations {action}","actionRequirements":"Le nom de l\'action doit comporter de 2 à 64 caractères et doit contenir uniquement des caractères alphanumériques ou le caractère *","actionSelectText":"Spécifiez les actions du service qui doivent être {effect}.","actions":"Actions","actionsBlock":{"header":"Actions {effect}","denied":"refusé","allowed":"autorisé"},"actionsMayNotBeSupported":"Une ou plusieurs actions peuvent ne pas prendre en charge cette ressource.","addAction":"Ajouter une action","addActionManually":"Ajouter une action manuellement","addActions":"Ajouter des actions","addArn":"Ajouter un ARN","addArnToRestrictAccess":"Ajoutez l\'ARN pour restreindre l\'accès.","addArns":"Saisir ou coller une liste d\'A