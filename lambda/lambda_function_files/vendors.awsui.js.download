  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  word-break: break-all;
  hyphens: auto;
  overflow-y: auto;
  overflow-x: hidden;
  background-color: #ffffff;
  flex: none;
  order: 0;
  flex-grow: 1;
  position: relative;
}

.InfoBoxContainer {
  display: flex;
  background-color: #ffffff;
  width: 100%;
  overflow: auto;
}
.InfoBoxContainer .InfoBoxSpace {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  word-break: break-all;
  max-height: 145px;
  order: 0;
  flex-grow: 1;
}

.CopyButton {
  padding: 10px;
}

.InfoBoxContainer.background {
  background-color: #f2f3f3;
}

.access-denied-popover-container {
  display: flex;
}

.access-denied-popover-content {
  flex: 1;
}

/* Flashbar only, light mode only. These boxes keep a light background in every context, but
   Cloudscape's Box and TextContent colour themselves from a design token that a Flashbar redefines
   to its inverted (near white) text colour, leaving white text on this white background. The alert
   variants do not invert, so they are left on the Cloudscape token untouched. Those component rules
   carry a \`:not(#\\9)\` specificity hack that a plain descendant selector cannot outrank, hence
   \`!important\`. Scoped to the message text so the copy button keeps its own Cloudscape colours.
   Dark mode needs none of this: the inverted text is readable on the dark box below. */
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxGrid,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxContainer .InfoBoxSpace {
  color: #000716; /* text-body-default https://polaris.a2z.com/foundation/visual-foundation/colors/ */
}
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxGrid code,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxGrid div,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxGrid p,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxGrid span,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxGrid strong,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxGrid em,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxContainer .InfoBoxSpace code,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxContainer .InfoBoxSpace div,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxContainer .InfoBoxSpace p,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxContainer .InfoBoxSpace span,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxContainer .InfoBoxSpace strong,
body:not(.awsui-dark-mode):not(.awsui-polaris-dark-mode) [data-alert-type=flashbar] .InfoBoxContainer .InfoBoxSpace em {
  color: inherit !important;
}

body.awsui-polaris-dark-mode .InfoBoxContainer,
body.awsui-polaris-dark-mode .InfoBoxSpace,
body.awsui-polaris-dark-mode .InfoBoxSpace.popover,
body.awsui-polaris-dark-mode .InfoBoxGrid {
